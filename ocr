      // Extract native text lines from PDF.js page preserving row alignment
      function extractStructuredPdfText(textContent) {
        const items = textContent.items || [];
        if (items.length === 0) return '';
        const linesMap = [];
        items.forEach(function (item) {
          const str = (item.str || '').trim();
          if (!str) return;
          const y = Math.round(item.transform[5] / 4) * 4;
          const x = item.transform[4];
          let lineObj = linesMap.find(function (l) { return Math.abs(l.y - y) <= 4; });
          if (!lineObj) {
            lineObj = { y: y, parts: [] };
            linesMap.push(lineObj);
          }
          lineObj.parts.push({ x: x, str: str });
        });

        linesMap.sort(function (a, b) { return b.y - a.y; });
        return linesMap.map(function (line) {
          line.parts.sort(function (a, b) { return a.x - b.x; });
          let out = '';
          for (let i = 0; i < line.parts.length; i++) {
            if (i > 0) {
              const gap = line.parts[i].x - line.parts[i - 1].x;
              out += gap > 45 ? '   ' : ' ';
            }
            out += line.parts[i].str;
          }
          return out.trim();
        }).filter(Boolean).join('\n');
      }

      // Main Extraction Pipeline (PDF + OCR)
      async function runExtraction() {
        if (!state.file || state.isProcessing) return;

        const isPdf = state.file.type === 'application/pdf' || state.file.name.toLowerCase().endsWith('.pdf');
        if (isPdf && !window.pdfjsLib) {
          showToast('PDF.js failed to load. Please check your internet connection.', 'error');
          return;
        }
        if (!window.Tesseract) {
          showToast('Tesseract.js OCR engine failed to load. Please check your internet connection.', 'error');
          return;
        }

        state.isProcessing = true;
        state.cancelRequested = false;
        state.pages = [];
        els.extractBtn.disabled = true;
        els.exportExcelBtn.disabled = true;
        els.exportPdfBtn.disabled = true;
        els.progressPanel.classList.remove('hidden');
        setProgress(5, 'Reading uploaded file...', 'Preparing document...');

        let worker = null;
        const mode = els.ocrModeSelect.value;
        const lang = els.ocrLangSelect.value;

        try {
          if (!isPdf) {
            const imgUrl = URL.createObjectURL(state.file);
            setProgress(15, 'Loading Tesseract OCR (' + lang + ')...', 'Initializing language model...');
            worker = await window.Tesseract.createWorker(lang, 1, {
              logger: function (m) {
                if (m.status === 'recognizing text' && typeof m.progress === 'number') {
                  setProgress(20 + m.progress * 75, 'Running OCR on image...', 'Recognizing text: ' + Math.round(m.progress * 100) + '%');
                }
              }
            });
            const result = await worker.recognize(imgUrl);
            URL.revokeObjectURL(imgUrl);
            state.pages.push({
              pageNum: 1,
              text: (result.data.text || '').trim(),
              method: 'OCR',
              confidence: Math.round(result.data.confidence || 0)
            });
          } else {
            const arrayBuffer = await state.file.arrayBuffer();
            let pdfDoc;
            try {
              pdfDoc = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            } catch (_workerErr) {
              pdfDoc = await window.pdfjsLib.getDocument({ data: arrayBuffer, disableWorker: true }).promise;
            }

            const totalPages = pdfDoc.numPages;
            els.previewCanvasWrap.classList.remove('hidden');

            for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
              if (state.cancelRequested) break;

              const basePct = ((pageNum - 1) / totalPages) * 100;
              setProgress(basePct + 2, 'Processing Page ' + pageNum + ' of ' + totalPages, 'Inspecting page content...');

              const page = await pdfDoc.getPage(pageNum);
              let pageText = '';
              let usedMethod = 'Native Text';
              let confidence = 100;

              if (mode === 'hybrid') {
                const textContent = await page.getTextContent();
                pageText = extractStructuredPdfText(textContent);
              }

              const viewport = page.getViewport({ scale: 2.0 });
              const canvas = els.pagePreviewCanvas;
              const ctx = canvas.getContext('2d');
              canvas.width = viewport.width;
              canvas.height = viewport.height;
              await page.render({ canvasContext: ctx, viewport: viewport }).promise;

              const needsOcr = mode === 'force_ocr' || pageText.replace(/\s+/g, '').length < 25;
              if (needsOcr) {
                usedMethod = 'OCR';
                if (!worker) {
                  setProgress(basePct + 5, 'Loading Tesseract OCR (' + lang + ')...', 'Downloading language model (cached after first use)...');
                  worker = await window.Tesseract.createWorker(lang, 1, {
                    logger: function (m) {
                      if (m.status === 'recognizing text' && typeof m.progress === 'number') {
                        const pageSlice = 100 / totalPages;
                        setProgress(
                          basePct + m.progress * pageSlice,
                          'Running OCR on Page ' + pageNum + ' of ' + totalPages,
                          'Recognizing text: ' + Math.round(m.progress * 100) + '%'
                        );
                      }
                    }
                  });
                }
                const ocrRes = await worker.recognize(canvas);
                pageText = (ocrRes.data.text || '').trim();
                confidence = Math.round(ocrRes.data.confidence || 0);
              }

              state.pages.push({
                pageNum: pageNum,
                text: pageText,
                method: usedMethod,
                confidence: confidence
              });
            }
          }

          if (worker) {
            await worker.terminate();
            worker = null;
          }

          if (state.cancelRequested) {
            showToast('Extraction cancelled.', 'info');
          } else {
            state.rawText = state.pages.map(function (p) {
              return '--- Page ' + p.pageNum + ' (' + p.method + ') ---\n' + (p.text || '(No text detected)');
            }).join('\n\n');

            const parsed = parseTextToTable(state.rawText, els.parseModeSelect.value);
            state.headers = parsed.headers;
            state.rows = parsed.rows;
            setProgress(100, 'Extraction complete!', 'Processed ' + state.pages.length + ' page(s). Ready to export.');
            showToast('Extracted ' + state.rows.length + ' rows from ' + state.pages.length + ' page(s).', 'success');
          }
        } catch (err) {
          console.error(err);
          showToast('Extraction failed: ' + (err && err.message ? err.message : 'Unknown error'), 'error');
        } finally {
          if (worker) {
            try { await worker.terminate(); } catch (_e) {}
          }
          state.isProcessing = false;
          els.extractBtn.disabled = !state.file;
          setTimeout(function () {
            if (!state.isProcessing) {
              els.progressPanel.classList.add('hidden');
            }
          }, 1200);
          renderAll();
        }
      }

      // Option 1: Export to Excel (.xlsx)
      function exportToExcel() {
        if (!window.XLSX) {
          showToast('SheetJS library not loaded. Check your internet connection.', 'error');
          return;
        }
        if (state.rows.length === 0 && !state.rawText.trim()) {
          showToast('No extracted data to export.', 'error');
          return;
        }

        try {
          const wb = window.XLSX.utils.book_new();

          const tableData = [state.headers].concat(state.rows);
          const wsTable = window.XLSX.utils.aoa_to_sheet(tableData);
          const colWidths = state.headers.map(function (h, idx) {
            let maxLen = String(h || '').length;
            state.rows.forEach(function (r) {
              const len = String(r[idx] || '').length;
              if (len > maxLen) maxLen = len;
            });
            return { wch: Math.min(Math.max(maxLen + 4, 14), 50) };
          });
          wsTable['!cols'] = colWidths;
          window.XLSX.utils.book_append_sheet(wb, wsTable, 'Extracted Data');

          const rawRows = [['Page', 'Method', 'Extracted Text']];
          if (state.pages.length > 0) {
            state.pages.forEach(function (p) {
              rawRows.push([p.pageNum, p.method, p.text]);
            });
          } else {
            rawRows.push([1, 'Edited Text', state.rawText]);
          }
          const wsRaw = window.XLSX.utils.aoa_to_sheet(rawRows);
          wsRaw['!cols'] = [{ wch: 8 }, { wch: 15 }, { wch: 90 }];
          window.XLSX.utils.book_append_sheet(wb, wsRaw, 'Raw OCR Text');

          const filename = (state.sourceName || 'ocr_extracted_data') + '_extracted.xlsx';
          window.XLSX.writeFile(wb, filename);
          showToast('Excel file downloaded: ' + filename, 'success');
        } catch (err) {
          console.error(err);
          showToast('Excel export failed: ' + err.message, 'error');
        }
      }

      // Option 2: Export to PDF (.pdf)
      function exportToPdf() {
        if (!window.jspdf || !window.jspdf.jsPDF) {
          showToast('jsPDF library not loaded. Check your internet connection.', 'error');
          return;
        }
        if (state.rows.length === 0 && !state.rawText.trim()) {
          showToast('No extracted data to export.', 'error');
          return;
        }

        try {
          const jsPDF = window.jspdf.jsPDF;
          const doc = new jsPDF({ orientation: state.headers.length > 5 ? 'landscape' : 'portrait', unit: 'pt', format: 'a4' });
          const margin = 40;

          doc.setFillColor(79, 70, 229);
          doc.rect(0, 0, doc.internal.pageSize.getWidth(), 64, 'F');
          doc.setTextColor(255, 255, 255);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(16);
          doc.text('OCR Extracted Data Report', margin, 32);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9.5);
          const metaLine = 'Source: ' + (state.sourceName || 'Uploaded Document') + '   |   Generated: ' + new Date().toLocaleString();
          doc.text(metaLine, margin, 49);

          let cursorY = 86;

          if (state.rows.length > 0 && typeof doc.autoTable === 'function') {
            doc.setTextColor(15, 23, 42);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(11);
            doc.text('Structured Data (' + state.rows.length + ' rows)', margin, cursorY);

            doc.autoTable({
              startY: cursorY + 10,
              head: [state.headers],
              body: state.rows,
              margin: { left: margin, right: margin },
              styles: { fontSize: 8.5, cellPadding: 5, textColor: [30, 41, 59] },
              headStyles: { fillColor: [79, 70, 229], textColor: [255, 255, 255], fontStyle: 'bold' },
              alternateRowStyles: { fillColor: [248, 250, 252] }
            });
            cursorY = (doc.lastAutoTable ? doc.lastAutoTable.finalY : cursorY) + 28;
          }

          if (state.rawText.trim()) {
            const pageHeight = doc.internal.pageSize.getHeight();
            const pageWidth = doc.internal.pageSize.getWidth();
            if (cursorY > pageHeight - 100) {
              doc.addPage();
              cursorY = 48;
            }
            doc.setTextColor(15, 23, 42);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(11);
            doc.text('Raw Extracted Text', margin, cursorY);
            cursorY += 16;

            doc.setFont('courier', 'normal');
            doc.setFontSize(8.5);
            doc.setTextColor(51, 65, 85);
            const wrapped = doc.splitTextToSize(state.rawText.trim(), pageWidth - margin * 2);
            wrapped.forEach(function (line) {
              if (cursorY > pageHeight - 40) {
                doc.addPage();
                cursorY = 44;
              }
              doc.text(line, margin, cursorY);
              cursorY += 12;
            });
          }

          const filename = (state.sourceName || 'ocr_extracted_data') + '_report.pdf';
          doc.save(filename);
          showToast('PDF report downloaded: ' + filename, 'success');
        } catch (err) {
          console.error(err);
          showToast('PDF export failed: ' + err.message, 'error');
        }
      }

