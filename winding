        function compositeCanvasOnWhite(sourceCanvas) {
            const tmp = document.createElement('canvas');
            tmp.width = Math.max(1, sourceCanvas.width);
            tmp.height = Math.max(1, sourceCanvas.height);
            const tctx = tmp.getContext('2d');
            tctx.fillStyle = '#ffffff';
            tctx.fillRect(0, 0, tmp.width, tmp.height);
            tctx.drawImage(sourceCanvas, 0, 0);
            return {
                dataUrl: tmp.toDataURL('image/png'),
                width: tmp.width,
                height: tmp.height
            };
        }

        async function captureAllChartsAsImages() {
            const chartsTab = document.getElementById('charts-tab');
            const wasHidden = chartsTab.classList.contains('hidden');
            const prevStyles = {
                position: chartsTab.style.position,
                left: chartsTab.style.left,
                top: chartsTab.style.top,
                width: chartsTab.style.width,
                visibility: chartsTab.style.visibility,
                zIndex: chartsTab.style.zIndex
            };

            // If Charts tab is hidden, reveal offscreen so Chart.js lays out real dimensions
            if (wasHidden) {
                chartsTab.style.position = 'fixed';
                chartsTab.style.left = '-9999px';
                chartsTab.style.top = '0';
                chartsTab.style.width = '760px';
                chartsTab.style.visibility = 'hidden';
                chartsTab.style.zIndex = '-1';
                chartsTab.classList.remove('hidden');
            }

            const chartKeys = ['efficiency', 'torqueSpeed', 'loss', 'current', 'harmonic', 'temperature'];
            const savedAnimations = {};

            // Disable animations and force synchronous resize + render
            chartKeys.forEach(key => {
                const ch = charts[key];
                if (!ch) return;
                savedAnimations[key] = ch.options.animation;
                ch.options.animation = false;
                ch.resize();
                ch.update('none');
            });

            // Allow browser layout & canvas paint to settle
            await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

            const captured = {};
            chartKeys.forEach(key => {
                const ch = charts[key];
                if (ch && ch.canvas && ch.canvas.width > 0 && ch.canvas.height > 0) {
                    captured[key] = compositeCanvasOnWhite(ch.canvas);
                } else {
                    captured[key] = null;
                }
                if (ch) {
                    ch.options.animation = savedAnimations[key];
                }
            });

            // Restore Charts tab visibility & dimensions
            if (wasHidden) {
                chartsTab.classList.add('hidden');
                Object.assign(chartsTab.style, prevStyles);
            } else {
                resizeAllCharts();
            }

            return captured;
        }

        function fitImageInBox(imgW, imgH, boxX, boxY, boxW, boxH) {
            const imgAspect = imgW / Math.max(1, imgH);
            const boxAspect = boxW / Math.max(1, boxH);
            let drawW, drawH;
            if (imgAspect > boxAspect) {
                drawW = boxW;
                drawH = boxW / imgAspect;
            } else {
                drawH = boxH;
                drawW = boxH * imgAspect;
            }
            const drawX = boxX + (boxW - drawW) / 2;
            const drawY = boxY + (boxH - drawH) / 2;
            return { x: drawX, y: drawY, w: drawW, h: drawH };
        }

        function sanitizePdfText(str) {
            // Strip emojis/non-Latin1 glyphs so jsPDF Helvetica renders crisply
            return String(str)
                .replace(/⭐/g, '*')
                .replace(/⚡/g, '')
                .replace(/🔇/g, '')
                .replace(/✅/g, '')
                .replace(/⚖️/g, '')
                .replace(/🔵/g, '')
                .replace(/−/g, '-')
                .replace(/×/g, 'x')
                .replace(/Ω/g, 'Ohm')
                .replace(/Δ/g, 'Delta')
                .replace(/[^\x20-\xFF]/g, '')
                .trim();
        }

