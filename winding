            if (!losses.meetsIE) {
                tips.push(`Efficiency (${losses.efficiency.toFixed(2)}%) is below ${ieClass} target (${losses.targetEfficiency.toFixed(1)}%). Consider increasing wire diameter or parallel paths to cut stator copper losses (${losses.statorCopper.toFixed(0)} W).`);
