        /* =========================================================================
           POLE-PHASE BELT SLOT ASSIGNMENT (True 3-Phase Spatial Sequence)
           Sequence per pole pair: A+, C-, B+, A-, C+, B-
        ========================================================================= */
        function getSlotPhaseBelt(slotIndex, totalSlots, poles) {
            const totalBelts = 3 * poles;
            const beltIndex = Math.floor((slotIndex * totalBelts) / totalSlots) % 6;
            const beltMap = [
                { phase: 0, sign: +1, label: 'A+' },
                { phase: 2, sign: -1, label: 'C-' },
                { phase: 1, sign: +1, label: 'B+' },
                { phase: 0, sign: -1, label: 'A-' },
                { phase: 2, sign: +1, label: 'C+' },
                { phase: 1, sign: -1, label: 'B-' }
            ];
            return beltMap[beltIndex];
        }

        /* =========================================================================
           INPUT VALIDATION & SANITIZATION
        ========================================================================= */
        function readAndValidateInputs() {
            const alerts = [];
            const clamp = (val, min, max, fallback) => {
                const num = parseFloat(val);
                if (!Number.isFinite(num)) return fallback;
                return Math.min(max, Math.max(min, num));
            };

            let slots = Math.round(clamp(document.getElementById('slots').value, 6, 144, 36));
            let poles = Math.round(clamp(document.getElementById('poles').value, 2, 16, 4));
            if (poles % 2 !== 0) {
                poles = Math.max(2, poles - 1);
                document.getElementById('poles').value = poles;
                alerts.push({ type: 'warning', text: `Poles adjusted to even number (${poles}).` });
            }

            const phases = 3;
            const slotsEl = document.getElementById('slots');
            slotsEl.classList.remove('input-invalid');

            if (slots % phases !== 0) {
                slotsEl.classList.add('input-invalid');
                alerts.push({
                    type: 'danger',
                    text: `Stator slots (${slots}) is not divisible by 3 phases. Balanced 3-phase winding requires S divisible by 3.`
                });
            }

            const slotsPerPole = slots / poles;
            const q = slots / (poles * phases);

            if (slotsPerPole < 3) {
                slotsEl.classList.add('input-invalid');
                alerts.push({
                    type: 'danger',
                    text: `Slots per pole (${slotsPerPole.toFixed(2)}) is below 3. Increase stator slots or reduce poles.`
                });
            } else if (!Number.isInteger(q)) {
                alerts.push({
                    type: 'warning',
                    text: `Fractional-slot winding detected (q = ${q.toFixed(3)} slots/pole/phase). Expect elevated sub-harmonics and unbalanced magnetic pull unless carefully designed.`
                });
            }

            const power = clamp(document.getElementById('power').value, 0.37, 500, 7.5);
            const voltage = clamp(document.getElementById('voltage').value, 110, 11000, 400);
            const frequency = clamp(document.getElementById('frequency').value, 25, 400, 50);
            const wireDiameter = clamp(document.getElementById('wireDiameter').value, 0.3, 6.0, 1.8);
            const turnsPerCoil = Math.round(clamp(document.getElementById('turnsPerCoil').value, 4, 300, 42));
            const parallelPaths = Math.round(clamp(document.getElementById('parallelPaths').value, 1, 8, 2));
            const powerFactor = clamp(document.getElementById('powerFactor').value, 0.55, 0.96, 0.87);
            const slotFillFactor = clamp(document.getElementById('slotFillFactor').value, 0.30, 0.90, 0.72);
            const testTemperature = clamp(document.getElementById('testTemperature').value, 10, 50, 25);
            const ambientTemperature = clamp(document.getElementById('ambientTemperature').value, -10, 60, 40);

            if (slotFillFactor > 0.80) {
                alerts.push({
                    type: 'warning',
                    text: `Slot fill factor (${(slotFillFactor * 100).toFixed(0)}%) exceeds 80%. Random-wound industrial stators typically target 65%–78% for manufacturability.`
                });
            }

            if (parallelPaths > poles) {
                alerts.push({
                    type: 'warning',
                    text: `Parallel paths (${parallelPaths}) exceeds pole count (${poles}). Standard lap windings allow a ≤ P.`
                });
            }

            renderValidationAlerts(alerts);

            return {
                slots,
                poles,
                phases,
                power,
                voltage,
                frequency,
                wireDiameter,
                turnsPerCoil,
                parallelPaths,
                powerFactor,
                windingType: document.getElementById('windingType').value,
                slotFillFactor,
                connectionType: document.getElementById('connectionType').value,
                ieClass: document.getElementById('ieClass').value,
                standard: document.getElementById('standard').value,
                frameSize: document.getElementById('frameSize').value,
                insulationClass: document.getElementById('insulationClass').value,
                enclosureType: document.getElementById('enclosureType').value,
                testTemperature,
                ambientTemperature,
                useManualLosses: document.getElementById('useManualLosses').checked
            };
        }

        function renderValidationAlerts(alerts) {
            const box = document.getElementById('validation-alerts');
            if (!alerts.length) {
                box.innerHTML = '';
                return;
            }
            box.innerHTML = alerts
                .map(a => `<div class="alert alert-${a.type}">${a.text}</div>`)
                .join('');
        }

        /* =========================================================================
           INDUSTRIAL MOTOR CALCULATOR ENGINE (IEC 60034 & NEMA MG-1)
        ========================================================================= */
        class IndustrialMotorCalculator {
            constructor(params, forcedSpan = null) {
                this.params = params;
                this.forcedSpan = forcedSpan;
            }

            // Harmonic distribution factor k_d(nu)
            calculateHarmonicDistributionFactor(nu = 1) {
                const { slots, poles, phases } = this.params;
                const q = Math.max(1, slots / (poles * phases));
                const beta = (Math.PI * poles) / slots;
                const denom = q * Math.sin((nu * beta) / 2);
                if (Math.abs(denom) < 1e-9) {
                    return Math.cos((nu * q * beta) / 2) >= 0 ? 1 : -1;
                }
                return Math.sin((nu * q * beta) / 2) / denom;
            }

            // Harmonic pitch factor k_p(nu)
            calculateHarmonicPitchFactor(coilSpan, nu = 1) {
                const { slots, poles } = this.params;
                const poleSpan = slots / poles;
                const epsilon = (1 - coilSpan / poleSpan) * Math.PI;
                return Math.cos((nu * epsilon) / 2);
            }

            calculateWindingFactor(coilSpan, nu = 1) {
                return this.calculateHarmonicDistributionFactor(nu) * this.calculateHarmonicPitchFactor(coilSpan, nu);
            }

            // Spatial MMF harmonic spectrum (5th, 7th, 11th, 13th, 17th, 19th)
            calculateHarmonicSpectrum(coilSpan) {
                const orders = [5, 7, 11, 13, 17, 19];
                const kw1 = Math.abs(this.calculateWindingFactor(coilSpan, 1)) || 1e-6;
                let sumSq = 0;

                const magnitudes = orders.map(nu => {
                    const kwNu = Math.abs(this.calculateWindingFactor(coilSpan, nu));
                    const relPct = (kwNu / (nu * kw1)) * 100;
                    sumSq += relPct * relPct;
                    return Number(relPct.toFixed(2));
                });

                return {
                    orders: orders.map(n => `${n}th`),
                    numericOrders: orders,
                    magnitudes,
                    thd: Math.sqrt(sumSq)
                };
            }

            // IEC 60034-30-1 Target Efficiency Table (50Hz/60Hz baseline)
            getTargetEfficiency() {
                const { power, poles, ieClass, frequency } = this.params;
                const table = {
                    IE2: {
                        2: { 0.75: 77.4, 1.5: 81.3, 3: 84.6, 5.5: 87.0, 7.5: 88.1, 11: 89.4, 15: 90.3, 22: 91.3, 37: 92.5, 75: 93.8, 160: 94.8, 375: 95.0 },
                        4: { 0.75: 79.6, 1.5: 82.8, 3: 85.5, 5.5: 87.7, 7.5: 88.7, 11: 89.8, 15: 90.6, 22: 91.6, 37: 92.7, 75: 94.0, 160: 94.9, 375: 95.1 },
                        6: { 0.75: 75.9, 1.5: 79.8, 3: 83.3, 5.5: 86.0, 7.5: 87.2, 11: 88.7, 15: 89.7, 22: 90.9, 37: 92.2, 75: 93.7, 160: 94.8, 375: 95.0 }
                    },
                    IE3: {
                        2: { 0.75: 80.7, 1.5: 84.2, 3: 87.1, 5.5: 89.2, 7.5: 90.1, 11: 91.2, 15: 91.9, 22: 92.7, 37: 93.7, 75: 94.7, 160: 95.6, 375: 95.8 },
                        4: { 0.75: 82.5, 1.5: 85.3, 3: 87.7, 5.5: 89.6, 7.5: 90.4, 11: 91.4, 15: 92.1, 22: 93.0, 37: 93.9, 75: 95.0, 160: 95.8, 375: 96.0 },
                        6: { 0.75: 78.9, 1.5: 82.5, 3: 85.6, 5.5: 88.0, 7.5: 89.1, 11: 90.3, 15: 91.2, 22: 92.2, 37: 93.3, 75: 94.6, 160: 95.6, 375: 95.8 }
                    },
                    IE4: {
                        2: { 0.75: 83.5, 1.5: 86.5, 3: 89.1, 5.5: 90.9, 7.5: 91.7, 11: 92.6, 15: 93.3, 22: 94.0, 37: 94.8, 75: 95.6, 160: 96.3, 375: 96.5 },
                        4: { 0.75: 85.7, 1.5: 88.2, 3: 90.4, 5.5: 91.9, 7.5: 92.6, 11: 93.3, 15: 93.9, 22: 94.5, 37: 95.2, 75: 96.0, 160: 96.6, 375: 96.7 },
                        6: { 0.75: 82.7, 1.5: 85.9, 3: 88.6, 5.5: 90.5, 7.5: 91.3, 11: 92.3, 15: 92.9, 22: 93.7, 37: 94.5, 75: 95.4, 160: 96.2, 375: 96.4 }
                    }
                };

                const poleKey = poles <= 2 ? 2 : (poles <= 4 ? 4 : 6);
                const curve = table[ieClass][poleKey];
                const powers = Object.keys(curve).map(Number).sort((a, b) => a - b);

                // Log-linear interpolation between standard IEC power points
                let eff;
                if (power <= powers[0]) {
                    eff = curve[powers[0]];
                } else if (power >= powers[powers.length - 1]) {
                    eff = curve[powers[powers.length - 1]];
                } else {
                    const idx = powers.findIndex(p => p >= power);
                    const p1 = powers[idx - 1], p2 = powers[idx];
                    const t = (Math.log10(power) - Math.log10(p1)) / (Math.log10(p2) - Math.log10(p1));
                    eff = curve[p1] + t * (curve[p2] - curve[p1]);
                }

                // 60Hz motors typically achieve ~0.4% higher efficiency per IEC 60034-30-1
                if (frequency >= 60) eff = Math.min(97.5, eff + 0.4);
                return eff;
            }

            // Determine IEC/NEMA Frame Size & Estimated Stator Geometry (meters)
            getFrameData() {
                const { power, standard, frameSize } = this.params;
                let code = frameSize;

                if (code === 'auto') {
                    if (standard === 'IEC') {
                        if (power <= 1.5) code = '90';
                        else if (power <= 4) code = '112';
                        else if (power <= 7.5) code = '132';
                        else if (power <= 15) code = '160';
                        else if (power <= 22) code = '180';
                        else if (power <= 37) code = '200';
                        else if (power <= 55) code = '225';
                        else code = '280';
                    } else {
                        if (power <= 2) code = 'NEMA143T';
                        else if (power <= 5.5) code = 'NEMA182T';
                        else if (power <= 11) code = 'NEMA213T';
                        else code = 'NEMA254T';
                    }
                }

                // Approximate shaft height H (mm) for thermal & MLT scaling
                const heightMap = {
                    '90': 90, '112': 112, '132': 132, '160': 160, '180': 180,
                    '200': 200, '225': 225, '280': 280,
                    'NEMA143T': 90, 'NEMA182T': 114, 'NEMA213T': 133, 'NEMA254T': 159
                };
                const frameHeightMm = heightMap[code] || 132;
                const boreDiameter = (frameHeightMm * 1.12) / 1000; // meters
                const stackLength = (frameHeightMm * 1.25) / 1000;  // meters

                return { code, frameHeightMm, boreDiameter, stackLength };
            }

            // Generate all candidate coil spans and identify optimal span
            generateSpans() {
                const { slots, poles } = this.params;
                const poleSpan = slots / poles;
                const minSpan = Math.max(1, Math.floor(poleSpan * 0.65));
                const maxSpan = Math.max(minSpan, Math.round(poleSpan));
                const idealFiveSixth = Math.round((poleSpan * 5) / 6);

                const spans = [];
                for (let s = minSpan; s <= maxSpan; s++) {
                    const kw1 = Math.abs(this.calculateWindingFactor(s, 1));
                    const kp1 = Math.abs(this.calculateHarmonicPitchFactor(s, 1));
                    const kd1 = Math.abs(this.calculateHarmonicDistributionFactor(1));
                    const pct = (s / poleSpan) * 100;
                    const harmonics = this.calculateHarmonicSpectrum(s);

                    spans.push({
                        span: s,
                        percentage: pct,
                        windingFactor: kw1,
                        pitchFactor: kp1,
                        distributionFactor: kd1,
                        thd: harmonics.thd,
                        harmonics,
                        description: Math.abs(pct - 100) < 0.5 ? 'Full Pitch (100%)' : `${pct.toFixed(1)}% Pitch`,
                        isOptimal: s === idealFiveSixth,
                        recommendation: this.getSpanRecommendation(kw1, harmonics.thd, pct)
                    });
                }

                // Fallback if idealFiveSixth wasn't in range
                if (!spans.some(sp => sp.isOptimal) && spans.length > 0) {
                    spans[Math.floor(spans.length / 2)].isOptimal = true;
                }

                return spans;
            }

            getSpanRecommendation(kw1, thd, pct) {
                if (Math.abs(pct - 100) < 0.5) return '⚡ Max Fundamental EMF';
                if (kw1 >= 0.90 && thd < 5.0) return '⭐ Optimal Balance';
                if (thd < 4.5) return '🔇 Low Harmonics';
                if (kw1 >= 0.92) return '✅ High Winding Factor';
                return '⚖️ Acceptable';
            }

            // Accurate Stator Phase Resistance (Ohm) with IEC temperature correction
            calculatePhaseResistance(activeSpan, frameData) {
                const { slots, poles, wireDiameter, turnsPerCoil, windingType, parallelPaths, testTemperature, insulationClass } = this.params;
                const rho20 = 1.724e-8; // Copper resistivity at 20°C (Ohm·m)

                const polePitch = (Math.PI * frameData.boreDiameter) / poles;
                const pitchRatio = activeSpan / (slots / poles);
                const coilPitchM = polePitch * pitchRatio;

                // Mean Length of Turn (MLT) in meters: 2*L_stack + end-turn overhang
                const mlt = 2 * frameData.stackLength + 2.55 * coilPitchM + 0.04;

                // Coils per phase (double layer: S/3 coils/phase, single layer: S/6 coils/phase)
                const coilsPerPhase = windingType === 'double' ? (slots / 3) : (slots / 6);
                const effectiveTurnsPerBranch = (coilsPerPhase * turnsPerCoil) / parallelPaths;
                const wireLengthPerBranch = effectiveTurnsPerBranch * mlt;

                // Wire cross-section in m²
                const dMeters = wireDiameter * 1e-3;
                const wireAreaM2 = Math.PI * Math.pow(dMeters / 2, 2);

                // Parallel branches reduce resistance by factor of parallelPaths
                const r20 = (rho20 * wireLengthPerBranch) / (wireAreaM2 * parallelPaths);

                // IEC 60034-2-1 reference temperatures by insulation class
                const refTempMap = { B: 95, F: 115, H: 130 };
                const refTemp = refTempMap[insulationClass] || 115;

                // Resistance at test temperature and corrected to reference temperature
                const rTest = r20 * ((234.5 + testTemperature) / (234.5 + 20));
                const rRef = rTest * ((234.5 + refTemp) / (234.5 + testTemperature));

                return { r20, rTest, rRef, mlt, refTemp };
            }

            // Realistic rated slip s_n based on shaft power & poles
            estimateRatedSlip() {
                const { power, poles } = this.params;
                // Typical IEC induction motor slip: ~4.2% at 0.75kW down to ~1.0% at 300kW
                const baseSlip = 0.042 * Math.pow(Math.max(0.5, power), -0.22);
                const poleFactor = 1 + (poles - 4) * 0.05;
                return Math.min(0.075, Math.max(0.008, baseSlip * poleFactor));
            }

            // Slot fill analysis
            calculateSlotFillDetails() {
                const wireDiameterMm = this.params.wireDiameter;
                const turns = this.params.turnsPerCoil;
                const layers = this.params.windingType === 'double' ? 2 : 1;

                const wireAreaMm2 = Math.PI * Math.pow(wireDiameterMm / 2, 2);
                const totalCopperAreaMm2 = wireAreaMm2 * turns * layers;
                const slotAreaMm2 = totalCopperAreaMm2 / this.params.slotFillFactor;

                return {
                    fillFactor: this.params.slotFillFactor,
                    copperArea: totalCopperAreaMm2,
                    slotArea: slotAreaMm2,
                    copperPercentage: this.params.slotFillFactor * 100,
                    windingType: this.params.windingType,
                    conductorsPerSlot: turns * layers,
                    coilSidesPerSlot: layers
                };
            }

            // Complete Physics-Consistent Loss & Efficiency Analysis
            calculateLossesAndCurrent(activeSpan, frameData) {
                const P_out = this.params.power * 1000; // Mechanical shaft output (W)
                const V_L = this.params.voltage;
                const pf = this.params.powerFactor;
                const targetEff = this.getTargetEfficiency();
                const ratedSlip = this.estimateRatedSlip();
                const resData = this.calculatePhaseResistance(activeSpan, frameData);

                // IEC 60034-2-1 Stray Load Loss allowance factor
                let strayFactor = 0.025;
                if (this.params.power >= 10000) {
                    strayFactor = 0.005;
                } else if (this.params.power > 1) {
                    strayFactor = 0.025 - 0.005 * Math.log10(this.params.power);
                }

                // Target total loss envelope for calibrating core & mechanical loss baselines
                const targetTotalLoss = P_out * (1 / (targetEff / 100) - 1);
                const freqScale = this.params.frequency / 50;
                const enclosureMechFactor = this.params.enclosureType === 'ODP' ? 0.85 : 1.05;

                // Iterative convergence (3 passes) so I_L, P_in, and 5-part losses are self-consistent
                let eta = targetEff / 100;
                let P_in = P_out / eta;
                let I_line = 0, I_phase = 0;
                let P_cu_s = 0, P_cu_r = 0, P_fe = 0, P_mech = 0, P_stray = 0;

                for (let iter = 0; iter < 3; iter++) {
                    P_in = P_out / Math.max(0.2, eta);
                    I_line = P_in / (Math.sqrt(3) * V_L * pf);
                    I_phase = this.params.connectionType === 'delta' ? I_line / Math.sqrt(3) : I_line;

                    P_cu_s = 3 * I_phase * I_phase * resData.rRef;
                    P_mech = targetTotalLoss * 0.14 * enclosureMechFactor * Math.pow(freqScale, 0.4);
                    P_fe = targetTotalLoss * 0.22 * Math.pow(freqScale, 0.3);
                    P_cu_r = (ratedSlip / (1 - ratedSlip)) * (P_out + P_mech);
                    P_stray = strayFactor * P_in;

                    const totalAutoLoss = P_cu_s + P_cu_r + P_fe + P_mech + P_stray;
                    eta = P_out / (P_out + totalAutoLoss);
                }

                // Check Manual Loss Override
                let isManual = false;
                if (this.params.useManualLosses) {
                    isManual = true;
                    const readOpt = (id, fallback) => {
                        const raw = document.getElementById(id).value;
                        if (raw === '' || raw === null) return fallback;
                        const v = parseFloat(raw);
                        return Number.isFinite(v) && v >= 0 ? v : fallback;
                    };
                    P_cu_s = readOpt('manualStatorCopperLoss', P_cu_s);
                    P_cu_r = readOpt('manualRotorCopperLoss', P_cu_r);
                    P_fe = readOpt('manualIronLoss', P_fe);
                    P_mech = readOpt('manualMechanicalLoss', P_mech);
                    P_stray = readOpt('manualStrayLoss', P_stray);
                }

                const totalLoss = P_cu_s + P_cu_r + P_fe + P_mech + P_stray;
                const finalEff = (P_out / (P_out + totalLoss)) * 100;
                P_in = P_out + totalLoss;
                I_line = P_in / (Math.sqrt(3) * V_L * pf);
                I_phase = this.params.connectionType === 'delta' ? I_line / Math.sqrt(3) : I_line;

                return {
                    statorCopper: P_cu_s,
                    rotorCopper: P_cu_r,
                    iron: P_fe,
                    mechanical: P_mech,
                    stray: P_stray,
                    total: totalLoss,
                    inputPower: P_in,
                    outputPower: P_out,
                    efficiency: finalEff,
                    targetEfficiency: targetEff,
                    meetsIE: finalEff >= targetEff - 0.3,
                    isManual,
                    lineCurrent: I_line,
                    phaseCurrent: I_phase,
                    ratedSlip,
                    resistance: resData
                };
            }

            // Generate all physics-driven chart datasets
            generatePerformanceData(losses, activeSpanObj, frameData) {
                const { frequency, poles, voltage, powerFactor, ambientTemperature, insulationClass, enclosureType } = this.params;
                const P_out = losses.outputPower;
                const P_const = losses.iron + losses.mechanical;
                const P_var = losses.statorCopper + losses.rotorCopper + losses.stray;

                // 1. Efficiency & Power Factor vs Load (25% to 125%)
                const loadPoints = [0.25, 0.50, 0.75, 1.00, 1.10, 1.25];
                const I_rated = losses.lineCurrent;
                const I_mag = I_rated * Math.sin(Math.acos(Math.min(0.99, Math.max(0.1, powerFactor))));

                const effCurve = [];
                const pfCurve = [];
                loadPoints.forEach(x => {
                    const pMech = x * P_out;
                    const pLoss = P_const + x * x * P_var;
                    const pIn = pMech + pLoss;
                    const etaPct = (pMech / pIn) * 100;
                    const iActive = pIn / (Math.sqrt(3) * voltage);
                    const iTot = Math.sqrt(I_mag * I_mag + iActive * iActive);
                    const pfPct = (iActive / iTot) * 100;

                    effCurve.push(Number(etaPct.toFixed(2)));
                    pfCurve.push(Number(pfPct.toFixed(1)));
                });

                // 2. Current vs Load (0% to 125%)
                const currentLoadPoints = [0, 0.25, 0.50, 0.75, 1.00, 1.10, 1.25];
                const currentCurve = currentLoadPoints.map(x => {
                    const pIn = x * P_out + P_const + x * x * P_var;
                    const iActive = pIn / (Math.sqrt(3) * voltage);
                    return Number(Math.sqrt(I_mag * I_mag + iActive * iActive).toFixed(2));
                });

                // 3. Torque-Speed Curve using Kloss Formula (0 to Ns RPM, 32 smooth points)
                const Ns = (120 * frequency) / poles;
                const s_n = losses.ratedSlip;
                const N_n = Ns * (1 - s_n);
                const T_n = P_out / ((2 * Math.PI * N_n) / 60);

                // Breakdown torque ratio (typical IEC Design N / NEMA B: 2.4 - 2.8)
                const k_max = 2.6;
                const T_max = k_max * T_n;
                const s_max = s_n * (k_max + Math.sqrt(k_max * k_max - 1));

                const klossTorque = (s) => {
                    if (s <= 1e-6) return 0;
                    return (2 * T_max) / (s / s_max + s_max / s);
                };

                const torqueSpeedCurve = [];
                const steps = 32;
                for (let i = 0; i <= steps; i++) {
                    const rpm = (Ns * i) / steps;
                    const s = 1 - rpm / Ns;
                    torqueSpeedCurve.push({ x: Number(rpm.toFixed(1)), y: Number(klossTorque(s).toFixed(2)) });
                }

                // Key operating points
                const T_lrt = klossTorque(1.0);
                const N_max = Ns * (1 - s_max);
                const keyPoints = [
                    { x: 0, y: Number(T_lrt.toFixed(2)), label: `Locked-Rotor (${T_lrt.toFixed(1)} Nm)` },
                    { x: Number(N_max.toFixed(1)), y: Number(T_max.toFixed(2)), label: `Breakdown (${T_max.toFixed(1)} Nm @ ${N_max.toFixed(0)} RPM)` },
                    { x: Number(N_n.toFixed(1)), y: Number(T_n.toFixed(2)), label: `Rated (${T_n.toFixed(1)} Nm @ ${N_n.toFixed(0)} RPM)` }
                ];

                // 4. Thermal Profile vs Insulation Limit
                const limitMap = { B: 130, F: 155, H: 180 };
                const insLimit = limitMap[insulationClass] || 155;
                // Surface area scales roughly with frameHeight^2; R_th (°C/W) scales inversely
                const coolingFactor = { ODP: 0.78, IP55: 1.0, TEFC: 1.0, IP56: 1.08 }[enclosureType] || 1.0;
                const rThBase = (1.65 / Math.pow(frameData.frameHeightMm / 100, 1.85)) * coolingFactor;

                const dT_winding = Math.min(140, (losses.total * rThBase * 0.52) + (losses.statorCopper * rThBase * 0.35));
                const dT_core = dT_winding * 0.84;
                const dT_bearing = dT_winding * 0.58;
                const dT_frame = dT_winding * 0.45;

                const thermalTemps = [
                    Number((ambientTemperature + dT_winding).toFixed(1)),
                    Number((ambientTemperature + dT_core).toFixed(1)),
                    Number((ambientTemperature + dT_bearing).toFixed(1)),
                    Number((ambientTemperature + dT_frame).toFixed(1))
                ];

                return {
                    efficiencyVsLoad: {
                        labels: loadPoints.map(x => `${Math.round(x * 100)}%`),
                        efficiency: effCurve,
                        powerFactor: pfCurve
                    },
                    currentVsLoad: {
                        labels: currentLoadPoints.map(x => `${Math.round(x * 100)}%`),
                        current: currentCurve
                    },
                    torqueSpeed: {
                        Ns,
                        ratedSpeed: N_n,
                        ratedTorque: T_n,
                        breakdownTorque: T_max,
                        lockedRotorTorque: T_lrt,
                        curve: torqueSpeedCurve,
                        keyPoints
                    },
                    harmonics: activeSpanObj.harmonics,
                    thermal: {
                        locations: ['Winding Hot-Spot', 'Stator Core', 'Rotor / Bearing', 'Frame Surface'],
                        temperatures: thermalTemps,
                        limit: insLimit,
                        margin: insLimit - thermalTemps[0]
                    }
                };
            }

            performAnalysis() {
                const frameData = this.getFrameData();
                const spans = this.generateSpans();

                // Pick forced span if valid for current slot/pole combo, else optimal span
                let activeSpanObj = spans.find(s => s.span === this.forcedSpan);
                if (!activeSpanObj) {
                    activeSpanObj = spans.find(s => s.isOptimal) || spans[0];
                }

                const losses = this.calculateLossesAndCurrent(activeSpanObj.span, frameData);
                const slotFill = this.calculateSlotFillDetails();
                const performance = this.generatePerformanceData(losses, activeSpanObj, frameData);

                // Normalized 0–100 Design Score
                const effScore = Math.min(1, losses.efficiency / 96) * 35;
                const kwScore = Math.min(1, activeSpanObj.windingFactor / 0.96) * 25;
                const thdScore = Math.max(0, 1 - activeSpanObj.harmonics.thd / 20) * 20;
                const thermalScore = Math.max(0, Math.min(1, (performance.thermal.margin + 10) / 45)) * 20;
                const designScore = Math.round(Math.max(0, Math.min(100, effScore + kwScore + thdScore + thermalScore)));

                return {
                    params: this.params,
                    basic: {
                        slotsPerPole: this.params.slots / this.params.poles,
                        slotsPerPolePerPhase: this.params.slots / (this.params.poles * this.params.phases),
                        distributionFactor: activeSpanObj.distributionFactor,
                        pitchFactor: activeSpanObj.pitchFactor,
                        windingFactor: activeSpanObj.windingFactor,
                        synchronousSpeed: performance.torqueSpeed.Ns,
                        ratedSpeed: performance.torqueSpeed.ratedSpeed,
                        ratedTorque: performance.torqueSpeed.ratedTorque,
                        lineCurrent: losses.lineCurrent,
                        phaseCurrent: losses.phaseCurrent,
                        frameSize: frameData.code
                    },
                    activeSpan: activeSpanObj,
                    spans,
                    losses,
                    slotFill,
                    performance,
                    designScore,
                    ieClass: this.params.ieClass
                };
            }
        }

        /* =========================================================================
           MAIN CALCULATION ORCHESTRATOR
        ========================================================================= */
        function calculateMotorDesign() {
            try {
                updateStatus('Calculating...', null);
                const params = readAndValidateInputs();
                const calculator = new IndustrialMotorCalculator(params, selectedSpanValue);
                currentResults = calculator.performAnalysis();
                selectedSpanValue = currentResults.activeSpan.span;

                document.getElementById('activeSpanLabel').textContent = `1-${selectedSpanValue + 1} (y=${selectedSpanValue})`;

                updateResultsDisplay();
                updateSpanComparison();
                updateOptimizationResults();
                updateCharts();
                create3DMotor();
                if (currentMode === '2d') {
                    draw2DMotor();
                }

                updateStatus('Ready', scene ? countSceneMeshes(motorGroup) : 0);
            } catch (err) {
                console.error('Calculation error:', err);
                updateStatus('Error', 0);
                showToast('Calculation error: check input parameters.');
            }
        }

        function selectCoilSpan(spanValue) {
            selectedSpanValue = spanValue;
            calculateMotorDesign();
            showToast(`Active coil span updated to y = ${spanValue} (1-${spanValue + 1})`);
        }

        function countSceneMeshes(group) {
            let count = 0;
            if (!group) return 0;
            group.traverse(obj => { if (obj.isMesh) count++; });
            return count;
        }

