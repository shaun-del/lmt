                const kpiH = 14.5;

                kpis.forEach((k, idx) => {
                    const col = idx % kpiCols;
                    const row = Math.floor(idx / kpiCols);
                    const kx = margin + col * (kpiW + kpiGap);
                    const ky = y + row * (kpiH + 3);

                    doc.setFillColor(...colors.lightBg);
                    doc.setDrawColor(...colors.border);
                    doc.setLineWidth(0.3);
                    doc.roundedRect(kx, ky, kpiW, kpiH, 1.8, 1.8, 'FD');

                    doc.setFont('helvetica', 'normal');
                    doc.setFontSize(6.8);
                    doc.setTextColor(...colors.slate);
                    doc.text(k.label, kx + 2.5, ky + 4.2);

                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(9.5);
                    doc.setTextColor(...colors.blue);
                    doc.text(k.val, kx + 2.5, ky + 9.2);

                    doc.setFont('helvetica', 'normal');
                    doc.setFontSize(6.5);
                    doc.setTextColor(100, 116, 139);
                    doc.text(k.sub, kx + 2.5, ky + 12.8);
                });

                y += kpiH * 2 + 8;

                // Table 1: Input & Design Parameters
                y = drawSectionHeading('1. Input & Design Parameters', y);
                doc.autoTable({
                    startY: y,
                    margin: { left: margin, right: margin },
                    theme: 'grid',
                    head: [['Parameter', 'Value', 'Parameter', 'Value']],
                    body: [
                        ['Rated Output Power', `${params.power} kW`, 'Stator Slots / Poles', `${params.slots} Slots / ${params.poles} Poles`],
                        ['Line Voltage / Freq', `${params.voltage} V / ${params.frequency} Hz`, 'Winding Topology', `${params.windingType === 'double' ? 'Double Layer' : 'Single Layer'}, ${params.connectionType === 'delta' ? 'Delta' : 'Star (Y)'}`],
                        ['Wire Diameter', `${params.wireDiameter.toFixed(2)} mm`, 'Turns per Coil / Parallel Paths', `${params.turnsPerCoil} Turns / a = ${params.parallelPaths}`],
                        ['Rated Power Factor', `${params.powerFactor.toFixed(2)}`, 'Target Slot Fill Factor', `${(params.slotFillFactor * 100).toFixed(0)}%`],
                        ['Design Standard / IE', `${params.standard} / ${ieClass}`, 'Frame / Enclosure', `${basic.frameSize} / ${params.enclosureType}`],
                        ['Insulation Class', `Class ${params.insulationClass} (${performance.thermal.limit}°C Limit)`, 'Test / Ambient Temp', `${params.testTemperature}°C / ${params.ambientTemperature}°C`]
                    ],
                    styles: { fontSize: 7.8, cellPadding: 2.1, textColor: colors.navy, lineColor: colors.border, lineWidth: 0.2 },
                    headStyles: { fillColor: colors.blue, textColor: [255, 255, 255], fontStyle: 'bold' },
                    columnStyles: {
                        0: { fontStyle: 'bold', fillColor: colors.lightBg, cellWidth: 42 },
                        1: { cellWidth: 51 },
                        2: { fontStyle: 'bold', fillColor: colors.lightBg, cellWidth: 46 },
                        3: { cellWidth: 47 }
                    }
                });

                y = doc.lastAutoTable.finalY + 6;

                // Table 2: Electrical & Slot Fill Results
                y = drawSectionHeading('2. Electrical Performance & Slot Fill Analysis', y);
                doc.autoTable({
                    startY: y,
                    margin: { left: margin, right: margin },
                    theme: 'grid',
                    head: [['Metric', 'Calculated Value', 'Metric', 'Calculated Value']],
                    body: [
                        ['Synchronous Speed (Ns)', `${basic.synchronousSpeed.toFixed(0)} RPM`, 'Rated Speed (Nn) / Slip', `${basic.ratedSpeed.toFixed(0)} RPM (${(losses.ratedSlip * 100).toFixed(2)}%)`],
                        ['Rated Shaft Torque (Tn)', `${basic.ratedTorque.toFixed(2)} Nm`, 'Breakdown / Locked-Rotor Torque', `${performance.torqueSpeed.breakdownTorque.toFixed(1)} Nm / ${performance.torqueSpeed.lockedRotorTorque.toFixed(1)} Nm`],
                        ['Full-Load Line Current', `${basic.lineCurrent.toFixed(2)} A`, 'Phase Current (Iph)', `${basic.phaseCurrent.toFixed(2)} A`],
                        [`Phase Resistance (${losses.resistance.refTemp}°C)`, `${losses.resistance.rRef.toFixed(4)} Ohm`, 'Mean Length of Turn (MLT)', `${(losses.resistance.mlt * 1000).toFixed(1)} mm`],
                        ['Distribution / Pitch Factor', `kd1 = ${basic.distributionFactor.toFixed(4)} / kp1 = ${basic.pitchFactor.toFixed(4)}`, 'Fundamental Winding Factor', `kw1 = ${basic.windingFactor.toFixed(4)}`],
                        ['Copper Area / Slot Area', `${slotFill.copperArea.toFixed(1)} mm2 / ${slotFill.slotArea.toFixed(1)} mm2`, 'Conductors per Slot', `${slotFill.conductorsPerSlot} (${slotFill.coilSidesPerSlot} coil side/slot)`]
                    ],
                    styles: { fontSize: 7.8, cellPadding: 2.1, textColor: colors.navy, lineColor: colors.border, lineWidth: 0.2 },
                    headStyles: { fillColor: colors.blue, textColor: [255, 255, 255], fontStyle: 'bold' },
                    columnStyles: {
                        0: { fontStyle: 'bold', fillColor: colors.lightBg, cellWidth: 45 },
                        1: { cellWidth: 48 },
                        2: { fontStyle: 'bold', fillColor: colors.lightBg, cellWidth: 46 },
                        3: { cellWidth: 47 }
                    }
                });

                y = doc.lastAutoTable.finalY + 6;

                // Table 3: 5-Part Loss Segregation
                const lossModeLabel = losses.isManual ? 'Manual / Measured Test Input' : 'IEC 60034-2-1 Auto-Calculated';
                y = drawSectionHeading(`3. 5-Part Loss Segregation (${lossModeLabel})`, y);
                const totL = Math.max(1e-6, losses.total);
                doc.autoTable({
                    startY: y,
                    margin: { left: margin, right: margin },
                    theme: 'grid',
                    head: [['Loss Component', 'Power Loss (W)', 'Share of Total Loss (%)', '% of Electrical Input']],
                    body: [
                        ['Stator Copper Loss (Pcu,s)', losses.statorCopper.toFixed(1), `${((losses.statorCopper / totL) * 100).toFixed(1)}%`, `${((losses.statorCopper / losses.inputPower) * 100).toFixed(2)}%`],
                        ['Rotor Copper Loss (Pcu,r)', losses.rotorCopper.toFixed(1), `${((losses.rotorCopper / totL) * 100).toFixed(1)}%`, `${((losses.rotorCopper / losses.inputPower) * 100).toFixed(2)}%`],
                        ['Core / Iron Loss (Pfe)', losses.iron.toFixed(1), `${((losses.iron / totL) * 100).toFixed(1)}%`, `${((losses.iron / losses.inputPower) * 100).toFixed(2)}%`],
                        ['Mechanical & Windage Loss (Pfw)', losses.mechanical.toFixed(1), `${((losses.mechanical / totL) * 100).toFixed(1)}%`, `${((losses.mechanical / losses.inputPower) * 100).toFixed(2)}%`],
                        ['Stray Load Loss (Pstray)', losses.stray.toFixed(1), `${((losses.stray / totL) * 100).toFixed(1)}%`, `${((losses.stray / losses.inputPower) * 100).toFixed(2)}%`],
                        [
                            { content: `Total Losses  |  Pin: ${(losses.inputPower / 1000).toFixed(2)} kW  ->  Pout: ${(losses.outputPower / 1000).toFixed(2)} kW`, styles: { fontStyle: 'bold', fillColor: [239, 246, 255] } },
                            { content: `${losses.total.toFixed(1)} W`, styles: { fontStyle: 'bold', fillColor: [239, 246, 255] } },
                            { content: '100.0%', styles: { fontStyle: 'bold', fillColor: [239, 246, 255] } },
                            { content: `Eff: ${losses.efficiency.toFixed(2)}%`, styles: { fontStyle: 'bold', fillColor: [239, 246, 255], textColor: colors.blue } }
                        ]
                    ],
                    styles: { fontSize: 7.8, cellPadding: 2.1, textColor: colors.navy, lineColor: colors.border, lineWidth: 0.2, halign: 'center' },
                    headStyles: { fillColor: colors.blue, textColor: [255, 255, 255], fontStyle: 'bold' },
                    columnStyles: { 0: { halign: 'left', fontStyle: 'bold' } }
                });

                /* =============================================================
                   PAGE 2: 3D & 2D VISUALIZATIONS, COIL SPAN TABLE & SUMMARY
                ============================================================= */
                doc.addPage();
                y = 18;
                y = drawSectionHeading('4. 3D Stator/Rotor Assembly & 2D Pole-Phase Belt Winding Layout', y);

                const imgBoxGap = 6;
                const imgBoxW = (contentW - imgBoxGap) / 2;
                const imgBoxH = 72;

                // Left Box: 3D Motor Model
                doc.setFillColor(15, 23, 42);
                doc.setDrawColor(...colors.border);
                doc.setLineWidth(0.35);
                doc.roundedRect(margin, y, imgBoxW, imgBoxH, 2, 2, 'FD');
                if (img3D) {
                    const fit3D = fitImageInBox(img3D.width, img3D.height, margin + 1.5, y + 1.5, imgBoxW - 3, imgBoxH - 9);
                    doc.addImage(img3D.dataUrl, 'PNG', fit3D.x, fit3D.y, fit3D.w, fit3D.h);
                }
                doc.setFillColor(30, 41, 59);
                doc.rect(margin, y + imgBoxH - 7, imgBoxW, 7, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(7.5);
                doc.setTextColor(255, 255, 255);
                doc.text(`3D Motor Geometry (${params.slots}S / ${params.poles}P, ${params.windingType} layer)`, margin + imgBoxW / 2, y + imgBoxH - 2.4, { align: 'center' });

                // Right Box: 2D Pole-Phase Belt Diagram
                const rightBoxX = margin + imgBoxW + imgBoxGap;
                doc.setFillColor(248, 250, 252);
                doc.setDrawColor(...colors.border);
                doc.roundedRect(rightBoxX, y, imgBoxW, imgBoxH, 2, 2, 'FD');
                if (img2D) {
                    const fit2D = fitImageInBox(img2D.width, img2D.height, rightBoxX + 1.5, y + 1.5, imgBoxW - 3, imgBoxH - 9);
                    doc.addImage(img2D.dataUrl, 'PNG', fit2D.x, fit2D.y, fit2D.w, fit2D.h);
                }
                doc.setFillColor(226, 232, 240);
                doc.rect(rightBoxX, y + imgBoxH - 7, imgBoxW, 7, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(7.5);
                doc.setTextColor(...colors.navy);
                doc.text(`2D Pole-Phase Winding (Active Span 1-${activeSpan.span + 1}, y=${activeSpan.span})`, rightBoxX + imgBoxW / 2, y + imgBoxH - 2.4, { align: 'center' });

                // Phase Color Legend Strip below images
                y += imgBoxH + 3.5;
                doc.setFillColor(...colors.lightBg);
                doc.setDrawColor(...colors.border);
                doc.roundedRect(margin, y, contentW, 8, 1.5, 1.5, 'FD');

                doc.setFont('helvetica', 'bold');
                doc.setFontSize(7.5);
                doc.setTextColor(...colors.navy);
                doc.text('3-Phase Color Legend (Pole-Phase Sequence: A+, C-, B+, A-, C+, B-):', margin + 3.5, y + 5.2);

                const legendItems = [
                    { name: 'Phase A', rgb: [239, 68, 68], x: margin + 106 },
                    { name: 'Phase B', rgb: [16, 185, 129], x: margin + 132 },
                    { name: 'Phase C', rgb: [59, 130, 246], x: margin + 158 }
                ];
                legendItems.forEach(item => {
                    doc.setFillColor(...item.rgb);
                    doc.circle(item.x, y + 4.1, 1.8, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(7.5);
                    doc.setTextColor(...colors.navy);
                    doc.text(item.name, item.x + 3.2, y + 5.2);
                });

                y += 13;

                // Full Coil Span Comparison Table
                y = drawSectionHeading('5. Coil Span & Winding Factor Comparison', y);
                const fullPitchThd = Math.max(0.01, spans[spans.length - 1]?.thd || activeSpan.thd);
                const spanRows = spans.map(sp => {
                    const isAct = sp.span === activeSpan.span;
                    const thdRed = Math.max(0, ((fullPitchThd - sp.thd) / fullPitchThd) * 100);
                    const statusText = isAct
                        ? (sp.isOptimal ? 'ACTIVE / OPTIMAL' : 'ACTIVE')
                        : (sp.isOptimal ? 'Optimal' : sanitizePdfText(sp.recommendation));
                    return [
                        `1-${sp.span + 1} (y=${sp.span})`,
                        `${sp.percentage.toFixed(1)}%`,
                        sp.pitchFactor.toFixed(4),
                        sp.distributionFactor.toFixed(4),
                        sp.windingFactor.toFixed(4),
                        `${sp.thd.toFixed(2)}% (-${thdRed.toFixed(0)}%)`,
                        statusText
                    ];
                });

                doc.autoTable({
                    startY: y,
                    margin: { left: margin, right: margin },
                    theme: 'grid',
                    head: [['Coil Span', 'Pitch %', 'kp1', 'kd1', 'kw1', 'MMF THD (Red.)', 'Status / Assessment']],
                    body: spanRows,
                    styles: { fontSize: 7.6, cellPadding: 2.2, textColor: colors.navy, lineColor: colors.border, lineWidth: 0.2, halign: 'center' },
                    headStyles: { fillColor: colors.blue, textColor: [255, 255, 255], fontStyle: 'bold' },
                    didParseCell: data => {
                        if (data.section === 'body') {
                            const sp = spans[data.row.index];
                            if (sp && sp.span === activeSpan.span) {
                                data.cell.styles.fillColor = [219, 234, 254];
                                data.cell.styles.fontStyle = 'bold';
                                data.cell.styles.textColor = colors.blue;
                            } else if (sp && sp.isOptimal) {
                                data.cell.styles.fillColor = [236, 253, 245];
                            }
                        }
                    }
                });

                y = doc.lastAutoTable.finalY + 7;

                // Optimization, Thermal & Compliance Summary
                y = drawSectionHeading('6. Optimization, Thermal & Compliance Summary', y);

                const thermalMargin = performance.thermal.margin;
                const notes = [];
                if (losses.meetsIE) {
                    notes.push(`Efficiency Compliance: Calculated efficiency (${losses.efficiency.toFixed(2)}%) meets the ${ieClass} target (${losses.targetEfficiency.toFixed(1)}%).`);
                } else {
                    notes.push(`Efficiency Advisory: Calculated efficiency (${losses.efficiency.toFixed(2)}%) is below the ${ieClass} target (${losses.targetEfficiency.toFixed(1)}%). Consider increasing wire diameter or parallel paths to reduce stator copper loss (${losses.statorCopper.toFixed(0)} W).`);
                }
                notes.push(`Thermal Assessment: Estimated winding hot-spot is ${performance.thermal.temperatures[0]}°C against Class ${params.insulationClass} limit (${performance.thermal.limit}°C), providing ${thermalMargin >= 0 ? '+' : ''}${thermalMargin.toFixed(1)}°C thermal margin at ${params.ambientTemperature}°C ambient.`);
                notes.push(`Harmonic & Torque Profile: Active coil span 1-${activeSpan.span + 1} (y=${activeSpan.span}, ${activeSpan.percentage.toFixed(1)}% pitch) yields kw1 = ${activeSpan.windingFactor.toFixed(4)}, spatial MMF THD = ${activeSpan.thd.toFixed(2)}%, and Breakdown-to-Rated Torque ratio = ${(performance.torqueSpeed.breakdownTorque / performance.torqueSpeed.ratedTorque).toFixed(2)}x.`);
                notes.push(`Slot Manufacturability: ${params.windingType === 'double' ? 'Double-layer' : 'Single-layer'} winding with ${(slotFill.fillFactor * 100).toFixed(0)}% slot fill factor (${slotFill.conductorsPerSlot} conductors/slot, copper area ${slotFill.copperArea.toFixed(1)} mm2).`);

                // Summary box
                const boxStartY = y;
                const summaryHeight = Math.min(pageH - 22 - boxStartY, 64);
                doc.setFillColor(...colors.lightBg);
                doc.setDrawColor(...colors.border);
                doc.roundedRect(margin, boxStartY, contentW, summaryHeight, 2, 2, 'FD');

                // Score badge inside box
                const scoreRgb = designScore >= 80 ? colors.green : (designScore >= 60 ? colors.amber : colors.red);
                doc.setFillColor(...scoreRgb);
                doc.roundedRect(margin + 4, boxStartY + 4, 34, 15, 2, 2, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(7);
                doc.setTextColor(255, 255, 255);
                doc.text('DESIGN SCORE', margin + 21, boxStartY + 9, { align: 'center' });
                doc.setFontSize(12);
                doc.text(`${designScore} / 100`, margin + 21, boxStartY + 15.8, { align: 'center' });

                // Key metrics next to score badge
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(8.2);
                doc.setTextColor(...colors.navy);
                doc.text(`IE Status: ${losses.meetsIE ? `Meets ${ieClass}` : `Below ${ieClass}`}`, margin + 43, boxStartY + 9);
                doc.text(`Thermal Margin: ${thermalMargin >= 0 ? '+' : ''}${thermalMargin.toFixed(1)}°C`, margin + 92, boxStartY + 9);
                doc.text(`MMF THD: ${activeSpan.thd.toFixed(2)}%`, margin + 145, boxStartY + 9);

                doc.setFont('helvetica', 'normal');
                doc.setFontSize(7.6);
                doc.setTextColor(...colors.slate);
                doc.text(`Core: ${performance.thermal.temperatures[1]}°C  |  Bearing: ${performance.thermal.temperatures[2]}°C  |  Frame: ${performance.thermal.temperatures[3]}°C`, margin + 43, boxStartY + 15.5);

                // Engineering notes bullet list
                let noteY = boxStartY + 24;
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(7.6);
                doc.setTextColor(...colors.navy);
                notes.forEach(note => {
                    const wrapped = doc.splitTextToSize(`• ${sanitizePdfText(note)}`, contentW - 10);
                    if (noteY + wrapped.length * 3.6 <= boxStartY + summaryHeight - 2) {
                        doc.text(wrapped, margin + 5, noteY);
                        noteY += wrapped.length * 3.6 + 1.5;
                    }
                });

                /* =============================================================
                   PAGE 3: 2x3 GRID OF ALL 6 PHYSICS-DRIVEN ANALYTICAL CHARTS
                ============================================================= */
                doc.addPage();
                y = 18;
                y = drawSectionHeading('7. Live Performance & Analytical Characteristic Curves', y);

                const chartSpec = [
                    { key: 'efficiency', title: 'Efficiency & Power Factor vs Load' },
                    { key: 'torqueSpeed', title: 'Torque-Speed Characteristic (Kloss)' },
                    { key: 'loss', title: '5-Part Loss Distribution (W & %)' },
                    { key: 'current', title: 'Line Current vs Shaft Load (0%-125%)' },
                    { key: 'harmonic', title: `Spatial MMF Harmonic Spectrum (y=${activeSpan.span})` },
                    { key: 'temperature', title: `Thermal Profile vs Class ${params.insulationClass} Limit` }
                ];

                const gridCols = 2;
                const gridRows = 3;
                const gapX = 6;
                const gapY = 5.5;
                const availH = pageH - y - 18;
                const cardW = (contentW - gapX) / gridCols;
                const cardH = (availH - gapY * (gridRows - 1)) / gridRows;

                chartSpec.forEach((spec, idx) => {
                    const col = idx % gridCols;
                    const row = Math.floor(idx / gridCols);
                    const cx = margin + col * (cardW + gapX);
                    const cy = y + row * (cardH + gapY);

                    // Card border & header
                    doc.setFillColor(255, 255, 255);
                    doc.setDrawColor(...colors.border);
                    doc.setLineWidth(0.3);
                    doc.roundedRect(cx, cy, cardW, cardH, 2, 2, 'FD');

                    doc.setFillColor(...colors.lightBg);
                    doc.rect(cx + 0.2, cy + 0.2, cardW - 0.4, 6.5, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(7.5);
                    doc.setTextColor(...colors.navy);
                    doc.text(spec.title, cx + 3, cy + 4.5);

                    const cap = chartImgs[spec.key];
                    if (cap) {
                        const fit = fitImageInBox(cap.width, cap.height, cx + 2, cy + 8, cardW - 4, cardH - 10);
                        doc.addImage(cap.dataUrl, 'PNG', fit.x, fit.y, fit.w, fit.h);
                    } else {
                        doc.setFont('helvetica', 'italic');
                        doc.setFontSize(8);
                        doc.setTextColor(...colors.slate);
                        doc.text('Chart snapshot unavailable', cx + cardW / 2, cy + cardH / 2, { align: 'center' });
                    }
                });

                /* =============================================================
                   RUNNING HEADER & FOOTER ON ALL PAGES
                ============================================================= */
                const totalPages = doc.getNumberOfPages();
                for (let p = 1; p <= totalPages; p++) {
                    doc.setPage(p);

                    // Running Header
                    doc.setDrawColor(...colors.border);
                    doc.setLineWidth(0.3);
                    doc.line(margin, 12.5, pageW - margin, 12.5);

                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(8);
                    doc.setTextColor(...colors.blue);
                    doc.text('INDUSTRIAL MOTOR WINDING DESIGN CALCULATOR', margin, 9.5);

                    doc.setFont('helvetica', 'normal');
                    doc.setFontSize(7.5);
                    doc.setTextColor(...colors.slate);
                    doc.text(`${params.standard} / ${ieClass}  |  Tag: ${motorTag}`, pageW - margin, 9.5, { align: 'right' });

                    // Running Footer
                    doc.setDrawColor(...colors.border);
                    doc.line(margin, pageH - 13, pageW - margin, pageH - 13);

                    doc.setFont('helvetica', 'normal');
                    doc.setFontSize(7.2);
                    doc.setTextColor(...colors.slate);
                    doc.text(`Generated: ${timestampStr}`, margin, pageH - 8.2);
                    doc.text('IEC 60034 / NEMA MG-1 Engineering Datasheet', pageW / 2, pageH - 8.2, { align: 'center' });
                    doc.setFont('helvetica', 'bold');
                    doc.text(`Page ${p} of ${totalPages}`, pageW - margin, pageH - 8.2, { align: 'right' });
                }

                // Trigger PDF download
                const powerTag = String(params.power).replace('.', '_');
                const filename = `motor_design_report_${powerTag}kW_${params.poles}P_${dateStr}.pdf`;
                doc.save(filename);
                showToast(`PDF Report downloaded: ${filename}`, 4000);
            } catch (err) {
                console.error('PDF generation failed:', err);
                showToast('PDF export encountered an error — opening Print fallback.', 4000);
                setTimeout(() => window.print(), 400);
            } finally {
                pdfBtn.disabled = false;
                pdfBtn.innerHTML = origLabel;
            }
        }

        function resetCalculator() {
            document.getElementById('slots').value = 36;
            document.getElementById('poles').value = 4;
            document.getElementById('power').value = 7.5;
            document.getElementById('voltage').value = 400;
            document.getElementById('frequency').value = 50;
            document.getElementById('wireDiameter').value = 1.8;
            document.getElementById('turnsPerCoil').value = 42;
            document.getElementById('parallelPaths').value = 2;
            document.getElementById('powerFactor').value = 0.87;
            document.getElementById('windingType').value = 'double';
            document.getElementById('slotFillFactor').value = 0.72;
            document.getElementById('connectionType').value = 'star';
            document.getElementById('ieClass').value = 'IE3';
            document.getElementById('standard').value = 'IEC';
            document.getElementById('frameSize').value = 'auto';
            document.getElementById('insulationClass').value = 'F';
            document.getElementById('enclosureType').value = 'IP55';
            document.getElementById('testTemperature').value = 25;
            document.getElementById('ambientTemperature').value = 40;
            document.getElementById('useManualLosses').checked = false;
            document.getElementById('manualLossInputs').classList.add('hidden');
            ['manualStatorCopperLoss', 'manualRotorCopperLoss', 'manualIronLoss', 'manualMechanicalLoss', 'manualStrayLoss']
                .forEach(id => { document.getElementById(id).value = ''; });

            selectedSpanValue = null;
            resetCamera();
            calculateMotorDesign();
            showToast('All motor parameters reset to IEC industrial defaults.');
        }

        function updateStatus(status, objectCount) {
            document.getElementById('calculationStatus').textContent = status;
            if (objectCount !== null) {
                document.getElementById('objectCount').textContent = objectCount;
            }
        }

        function handleResize() {
            if (currentMode === '3d' && renderer && camera) {
                const container = document.getElementById('threejs-container');
                const w = container.clientWidth;
                const h = container.clientHeight;
                if (w > 0 && h > 0) {
                    camera.aspect = w / h;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, h);
                }
            } else {
                resizeCanvas2D();
            }
        }

        /* =========================================================================
           BOOT APPLICATION ON WINDOW LOAD
        ========================================================================= */
        window.addEventListener('resize', handleResize);
        window.addEventListener('load', () => {
            init3DViewer();
            init2DViewer();
            initCharts();
            calculateMotorDesign();
            animate3D();
        });
    </script>
</body>
</html>
