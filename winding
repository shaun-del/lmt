        function setupOrbitControls(container) {
            let isDragging = false;
            let lastX = 0, lastY = 0;
            let pinchStartDist = 0;

            container.addEventListener('mousedown', e => {
                if (e.button === 0) {
                    isDragging = true;
                    lastX = e.clientX;
                    lastY = e.clientY;
                }
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            window.addEventListener('mousemove', e => {
                if (!isDragging) return;
                const dx = e.clientX - lastX;
                const dy = e.clientY - lastY;
                orbitState.targetRotationY -= dx * 0.008;
                orbitState.targetRotationX = Math.max(-1.45, Math.min(1.45, orbitState.targetRotationX + dy * 0.008));
                lastX = e.clientX;
                lastY = e.clientY;
            });

            container.addEventListener('wheel', e => {
                e.preventDefault();
                const zoom = e.deltaY > 0 ? 1.09 : 0.92;
                orbitState.targetDistance = Math.max(75, Math.min(340, orbitState.targetDistance * zoom));
            }, { passive: false });

            // Touch support for mobile/tablet
            container.addEventListener('touchstart', e => {
                if (e.touches.length === 1) {
                    isDragging = true;
                    lastX = e.touches[0].clientX;
                    lastY = e.touches[0].clientY;
                } else if (e.touches.length === 2) {
                    isDragging = false;
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    pinchStartDist = Math.hypot(dx, dy);
                }
            }, { passive: true });

            container.addEventListener('touchmove', e => {
                if (e.touches.length === 1 && isDragging) {
                    const dx = e.touches[0].clientX - lastX;
                    const dy = e.touches[0].clientY - lastY;
                    orbitState.targetRotationY -= dx * 0.01;
                    orbitState.targetRotationX = Math.max(-1.45, Math.min(1.45, orbitState.targetRotationX + dy * 0.01));
                    lastX = e.touches[0].clientX;
                    lastY = e.touches[0].clientY;
                } else if (e.touches.length === 2 && pinchStartDist > 0) {
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    const dist = Math.hypot(dx, dy);
                    const scale = pinchStartDist / Math.max(10, dist);
                    orbitState.targetDistance = Math.max(75, Math.min(340, orbitState.targetDistance * scale));
                    pinchStartDist = dist;
                }
            }, { passive: true });

            container.addEventListener('touchend', () => {
                isDragging = false;
                pinchStartDist = 0;
            });
        }

        function animate3D() {
            requestAnimationFrame(animate3D);
            orbitState.rotationX += (orbitState.targetRotationX - orbitState.rotationX) * 0.1;
            orbitState.rotationY += (orbitState.targetRotationY - orbitState.rotationY) * 0.1;
            orbitState.distance += (orbitState.targetDistance - orbitState.distance) * 0.1;

            camera.position.x = Math.sin(orbitState.rotationY) * Math.cos(orbitState.rotationX) * orbitState.distance;
            camera.position.y = Math.sin(orbitState.rotationX) * orbitState.distance;
            camera.position.z = Math.cos(orbitState.rotationY) * Math.cos(orbitState.rotationX) * orbitState.distance;
            camera.lookAt(0, 0, 0);

            renderer.render(scene, camera);
        }

        function clearMotorGroup() {
            [statorGroup, rotorGroup, windingGroup].forEach(group => {
                while (group.children.length > 0) {
                    const obj = group.children[0];
                    obj.traverse(child => {
                        if (child.geometry) child.geometry.dispose();
                        if (child.material) {
                            if (Array.isArray(child.material)) child.material.forEach(m => m.dispose());
                            else child.material.dispose();
                        }
                    });
                    group.remove(obj);
                }
            });
        }

        function create3DMotor() {
            clearMotorGroup();
            if (!currentResults) return;

            const { slots, poles, windingType, wireDiameter } = currentResults.params;
            const { slotFill, activeSpan } = currentResults;
            const stackLength = 74;
            const statorInnerR = 46;
            const statorOuterR = 66;

            // Hollow stator core ring via ExtrudeGeometry
            const coreShape = new THREE.Shape();
            coreShape.absarc(0, 0, statorOuterR, 0, Math.PI * 2, false);
            const boreHole = new THREE.Path();
            boreHole.absarc(0, 0, statorInnerR, 0, Math.PI * 2, true);
            coreShape.holes.push(boreHole);

            const coreGeo = new THREE.ExtrudeGeometry(coreShape, { depth: stackLength, bevelEnabled: false, curveSegments: Math.max(48, slots * 2) });
            coreGeo.rotateX(Math.PI / 2);
            coreGeo.translate(0, stackLength / 2, 0);

            const coreMat = new THREE.MeshPhongMaterial({
                color: 0x64748b,
                transparent: true,
                opacity: 0.55,
                shininess: 35,
                wireframe: wireframeEnabled
            });
            statorGroup.add(new THREE.Mesh(coreGeo, coreMat));

            // Slots & copper fill
            const slotDepth = 11;
            const slotWidth = Math.min(5.2, (2 * Math.PI * statorInnerR) / (slots * 1.9));
            const copperMat = new THREE.MeshPhongMaterial({ color: 0xc27834, shininess: 90 });
            const linerMat = new THREE.MeshBasicMaterial({ color: 0xe2e8f0, transparent: true, opacity: 0.7 });

            for (let i = 0; i < slots; i++) {
                const angle = (2 * Math.PI * i) / slots;
                const rSlot = statorInnerR + slotDepth / 2;
                const slotHolder = new THREE.Group();
                slotHolder.position.set(Math.cos(angle) * rSlot, 0, Math.sin(angle) * rSlot);
                slotHolder.rotation.y = -angle;

                if (showSlotFill) {
                    const fillDepth = slotDepth * 0.85 * slotFill.fillFactor;
                    if (windingType === 'double') {
                        const topCu = new THREE.Mesh(new THREE.BoxGeometry(fillDepth / 2, stackLength * 0.98, slotWidth * 0.85), copperMat);
                        topCu.position.x = -slotDepth * 0.2;
                        const botCu = new THREE.Mesh(new THREE.BoxGeometry(fillDepth / 2, stackLength * 0.98, slotWidth * 0.85), copperMat);
                        botCu.position.x = slotDepth * 0.22;
                        const sep = new THREE.Mesh(new THREE.BoxGeometry(0.6, stackLength * 0.99, slotWidth * 0.9), linerMat);
                        slotHolder.add(topCu, botCu, sep);
                    } else {
                        const singleCu = new THREE.Mesh(new THREE.BoxGeometry(fillDepth, stackLength * 0.98, slotWidth * 0.85), copperMat);
                        slotHolder.add(singleCu);
                    }
                }
                statorGroup.add(slotHolder);
            }

            // Rotor core, squirrel-cage bars & shaft
            const rotorR = 39;
            const rotorMesh = new THREE.Mesh(
                new THREE.CylinderGeometry(rotorR, rotorR, stackLength * 0.92, 40),
                new THREE.MeshPhongMaterial({ color: 0x475569, shininess: 45 })
            );
            rotorGroup.add(rotorMesh);

            const barCount = Math.max(16, Math.round(slots * 0.78));
            const barMat = new THREE.MeshPhongMaterial({ color: 0xf59e0b, shininess: 95 });
            for (let b = 0; b < barCount; b++) {
                const a = (2 * Math.PI * b) / barCount;
                const bar = new THREE.Mesh(new THREE.CylinderGeometry(1.1, 1.1, stackLength * 0.96, 8), barMat);
                bar.position.set(Math.cos(a) * (rotorR - 2.2), 0, Math.sin(a) * (rotorR - 2.2));
                rotorGroup.add(bar);
            }

            // End rings
            const ringGeo = new THREE.TorusGeometry(rotorR - 2.2, 2.0, 10, 40);
            ringGeo.rotateX(Math.PI / 2);
            const topRing = new THREE.Mesh(ringGeo, barMat);
            topRing.position.y = stackLength * 0.48;
            const botRing = new THREE.Mesh(ringGeo, barMat);
            botRing.position.y = -stackLength * 0.48;
            rotorGroup.add(topRing, botRing);

            // Steel shaft
            const shaft = new THREE.Mesh(
                new THREE.CylinderGeometry(10, 10, stackLength * 1.48, 24),
                new THREE.MeshPhongMaterial({ color: 0x94a3b8, shininess: 110 })
            );
            rotorGroup.add(shaft);

            // 3D End-Winding Coils using true pole-phase belt assignment
            const span = activeSpan.span;
            const tubeR = Math.max(0.75, Math.min(2.0, wireDiameter * 0.6));
            const rCoilTop = statorInnerR + 3.5;
            const rCoilBot = statorInnerR + 8.5;
            const step = windingType === 'double' ? 1 : 2;

            for (let i = 0; i < slots; i += step) {
                const belt = getSlotPhaseBelt(i, slots, poles);
                const color = PHASE_COLORS_INT[belt.phase];
                const endSlot = (i + span) % slots;

                const a1 = (2 * Math.PI * i) / slots;
                const a2 = (2 * Math.PI * endSlot) / slots;
                let aMid = a1 + (2 * Math.PI * span) / (2 * slots);

                // Top overhang arch
                const pTop1 = new THREE.Vector3(Math.cos(a1) * rCoilTop, stackLength / 2, Math.sin(a1) * rCoilTop);
                const pTopPeak = new THREE.Vector3(Math.cos(aMid) * (rCoilTop + 7), stackLength / 2 + 15, Math.sin(aMid) * (rCoilTop + 7));
                const pTop2 = new THREE.Vector3(Math.cos(a2) * rCoilBot, stackLength / 2, Math.sin(a2) * rCoilBot);

                const topCurve = new THREE.CatmullRomCurve3([pTop1, pTopPeak, pTop2]);
                const mat = new THREE.MeshPhongMaterial({ color, shininess: 75 });
                windingGroup.add(new THREE.Mesh(new THREE.TubeGeometry(topCurve, 20, tubeR, 6, false), mat));

                // Bottom overhang arch
                const pBot1 = new THREE.Vector3(Math.cos(a1) * rCoilTop, -stackLength / 2, Math.sin(a1) * rCoilTop);
                const pBotPeak = new THREE.Vector3(Math.cos(aMid) * (rCoilTop + 7), -stackLength / 2 - 15, Math.sin(aMid) * (rCoilTop + 7));
                const pBot2 = new THREE.Vector3(Math.cos(a2) * rCoilBot, -stackLength / 2, Math.sin(a2) * rCoilBot);

                const botCurve = new THREE.CatmullRomCurve3([pBot1, pBotPeak, pBot2]);
                windingGroup.add(new THREE.Mesh(new THREE.TubeGeometry(botCurve, 20, tubeR, 6, false), mat));
            }
        }

        /* =========================================================================
           2D WINDING VIEWER WITH POLAR/CARTESIAN GRID & POLE-PHASE BELTS
        ========================================================================= */
        function init2DViewer() {
            canvas2D = document.getElementById('motor2d-canvas');
            ctx2D = canvas2D.getContext('2d');
            resizeCanvas2D();
        }

        function resizeCanvas2D() {
            const container = document.getElementById('twod-container');
            if (!container || container.clientWidth === 0) return;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas2D.width = container.clientWidth * dpr;
            canvas2D.height = container.clientHeight * dpr;
            ctx2D.setTransform(dpr, 0, 0, dpr, 0, 0);
            if (currentMode === '2d') draw2DMotor();
        }

        function draw2DMotor() {
            if (!currentResults || !ctx2D) return;
            const container = document.getElementById('twod-container');
            const w = container.clientWidth;
            const h = container.clientHeight;
            if (w <= 0 || h <= 0) return;

            render2DMotorToContext(ctx2D, w, h, false);
        }

        // Shared 2D renderer supporting both live canvas and offscreen high-res PDF capture
        function render2DMotorToContext(ctx, w, h, fillBackground = false) {
            if (!currentResults || !ctx || w <= 0 || h <= 0) return;

            ctx.clearRect(0, 0, w, h);
            if (fillBackground) {
                ctx.fillStyle = '#f8fafc';
                ctx.fillRect(0, 0, w, h);
            }

            const cx = w / 2;
            const cy = h / 2;
            const radius = Math.min(w, h) * 0.34;
            const { slots, poles, windingType } = currentResults.params;
            const { activeSpan } = currentResults;

            // 1. Optional Engineering Polar/Cartesian Grid & Degree Markers
            if (show2DGrid || fillBackground) {
                draw2DEngineeringGrid(ctx, cx, cy, radius, w, h);
            }

            // 2. Stator Outer/Inner Rings & Rotor
            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 10;
            ctx.beginPath();
            ctx.arc(cx, cy, radius + 24, 0, Math.PI * 2);
            ctx.stroke();

            const rotorGrad = ctx.createRadialGradient(cx, cy, 4, cx, cy, radius * 0.56);
            rotorGrad.addColorStop(0, '#94a3b8');
            rotorGrad.addColorStop(1, '#475569');
            ctx.fillStyle = rotorGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, radius * 0.56, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#1e293b';
            ctx.beginPath();
            ctx.arc(cx, cy, radius * 0.14, 0, Math.PI * 2);
            ctx.fill();

            // 3. Draw End-Winding Coil Span Arcs (True Pole-Phase Belts)
            const span = activeSpan.span;
            const step = windingType === 'double' ? 1 : 2;
            for (let i = 0; i < slots; i += step) {
                const belt = getSlotPhaseBelt(i, slots, poles);
                const endSlot = (i + span) % slots;

                const a1 = (2 * Math.PI * i) / slots - Math.PI / 2;
                const a2 = (2 * Math.PI * endSlot) / slots - Math.PI / 2;
                const x1 = cx + Math.cos(a1) * radius;
                const y1 = cy + Math.sin(a1) * radius;
                const x2 = cx + Math.cos(a2) * radius;
                const y2 = cy + Math.sin(a2) * radius;

                const aMid = a1 + (2 * Math.PI * span) / (2 * slots);
                const ctrlR = radius * 0.66;
                const ctrlX = cx + Math.cos(aMid) * ctrlR;
                const ctrlY = cy + Math.sin(aMid) * ctrlR;

                ctx.strokeStyle = PHASE_COLORS_HEX[belt.phase];
                ctx.globalAlpha = 0.72;
                ctx.lineWidth = 2.4;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.quadraticCurveTo(ctrlX, ctrlY, x2, y2);
                ctx.stroke();
            }
            ctx.globalAlpha = 1.0;

            // 4. Draw Stator Slots, Copper Fill & Phase Belt Polarity
            const slotR = Math.max(7, Math.min(13, (Math.PI * radius) / (slots * 1.45)));
            for (let i = 0; i < slots; i++) {
                const angle = (2 * Math.PI * i) / slots - Math.PI / 2;
                const x = cx + Math.cos(angle) * radius;
                const y = cy + Math.sin(angle) * radius;
                const belt = getSlotPhaseBelt(i, slots, poles);
                const color = PHASE_COLORS_HEX[belt.phase];

                // Slot circle
                ctx.fillStyle = showSlotFill ? color : '#ffffff';
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.arc(x, y, slotR, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // Polarity symbol (+ / -)
                ctx.fillStyle = showSlotFill ? '#ffffff' : color;
                ctx.font = `bold ${Math.max(8, Math.round(slotR * 1.15))}px Inter, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(belt.sign > 0 ? '+' : '−', x, y + 0.5);

                // Slot number outside ring
                if (slots <= 48 || i % 2 === 0) {
                    const lx = cx + Math.cos(angle) * (radius + 37);
                    const ly = cy + Math.sin(angle) * (radius + 37);
                    ctx.fillStyle = '#334155';
                    ctx.font = '600 10px Inter, sans-serif';
                    ctx.fillText(String(i + 1), lx, ly);
                }
            }

            // 5. Phase A/B/C & Active Span Legend Box
            draw2DLegend(ctx, w, h, activeSpan, slots, poles, windingType);
        }

        function draw2DEngineeringGrid(ctx, cx, cy, radius, w, h) {
            ctx.save();

            // Subtle Cartesian crosshair
            ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(0, cy); ctx.lineTo(w, cy);
            ctx.moveTo(cx, 0); ctx.lineTo(cx, h);
            ctx.stroke();

            // Concentric polar rings
            [0.35, 0.7, 1.0, 1.32].forEach(mult => {
                ctx.beginPath();
                ctx.arc(cx, cy, radius * mult, 0, Math.PI * 2);
                ctx.stroke();
            });

            // Radial degree lines every 30°
            ctx.setLineDash([]);
            ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
            ctx.fillStyle = '#64748b';
            ctx.font = '600 10px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            for (let deg = 0; deg < 360; deg += 30) {
                const rad = ((deg - 90) * Math.PI) / 180;
                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(rad) * radius * 0.2, cy + Math.sin(rad) * radius * 0.2);
                ctx.lineTo(cx + Math.cos(rad) * (radius * 1.32), cy + Math.sin(rad) * (radius * 1.32));
                ctx.stroke();

                const tx = cx + Math.cos(rad) * (radius * 1.42);
                const ty = cy + Math.sin(rad) * (radius * 1.42);
                ctx.fillText(`${deg}°`, tx, ty);
            }

            ctx.restore();
        }

        function draw2DLegend(ctx, w, h, activeSpan, slots, poles, windingType) {
            ctx.save();
            const boxX = 16, boxY = h - 98, boxW = 225, boxH = 82;
            ctx.fillStyle = 'rgba(255, 255, 255, 0.93)';
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            if (typeof ctx.roundRect === 'function') {
                ctx.roundRect(boxX, boxY, boxW, boxH, 10);
            } else {
                ctx.rect(boxX, boxY, boxW, boxH);
            }
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#0f172a';
            ctx.font = '700 11px Inter, sans-serif';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'top';
            ctx.fillText(`Pole-Phase Belts (${slots}S / ${poles}P, ${windingType})`, boxX + 10, boxY + 10);

            ctx.font = '600 10.5px Inter, sans-serif';
            ctx.fillStyle = '#475569';
            ctx.fillText(`Coil Span: 1-${activeSpan.span + 1} (y=${activeSpan.span}, kw1=${activeSpan.windingFactor.toFixed(3)})`, boxX + 10, boxY + 28);

            // Phase dots
            PHASE_NAMES.forEach((name, idx) => {
                const px = boxX + 14 + idx * 70;
                const py = boxY + 58;
                ctx.fillStyle = PHASE_COLORS_HEX[idx];
                ctx.beginPath();
                ctx.arc(px, py, 5, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = '#1e293b';
                ctx.font = '600 11px Inter, sans-serif';
                ctx.textBaseline = 'middle';
                ctx.fillText(`Phase ${name}`, px + 9, py);
            });

            ctx.restore();
        }

