                `;
            }).join('');

            document.getElementById('span-comparison').innerHTML = `
                <div class="result-card">
                    <h3><span>🎯 Interactive Coil Span Analysis</span> <span class="industrial-badge">CLICK ROW</span></h3>
                    <div class="span-selection">
