<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- External Libraries: Tailwind CSS, Three.js r128, Chart.js 3.9.1, jsPDF & AutoTable -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Fixed universal selector */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0b1120 0%, #172554 50%, #1e293b 100%);
            min-height: 100vh;
            color: #1f2937;
            overflow-x: hidden;
        }

        .container-app {
            max-width: 1920px;
            margin: 0 auto;
            padding: 16px;
        }

        .header-banner {
            text-align: center;
            color: white;
            margin-bottom: 20px;
            padding: 28px 24px;
            background: rgba(15, 23, 42, 0.72);
            border-radius: 18px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

        .header-banner h1 {
            font-size: clamp(1.6rem, 3.2vw, 2.8rem);
            font-weight: 800;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
            background: linear-gradient(90deg, #f8fafc 0%, #60a5fa 55%, #38bdf8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-banner p {
            font-size: clamp(0.88rem, 1.2vw, 1.05rem);
            color: #cbd5e1;
        }

        .main-layout {
            display: grid;
            grid-template-columns: 370px minmax(420px, 1fr) 440px;
            gap: 20px;
            align-items: start;
        }

        .panel {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 18px 38px rgba(0, 0, 0, 0.24);
            border: 1px solid rgba(255, 255, 255, 0.35);
            max-height: 920px;
            overflow-y: auto;
        }

        .panel::-webkit-scrollbar {
            width: 7px;
        }
        .panel::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .panel::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .panel::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .viewer-panel {
            position: relative;
            min-height: 820px;
            height: 920px;
            padding: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .section-title {
            font-size: 1.25rem;
            color: #1e3a8a;
            margin-bottom: 16px;
            border-bottom: 3px solid #e2e8f0;
            padding-bottom: 10px;
            font-weight: 700;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 72px;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #0ea5e9);
            border-radius: 2px;
        }

        .tabs {
            display: flex;
            margin-bottom: 18px;
            background: #e2e8f0;
            border-radius: 12px;
            padding: 4px;
            gap: 4px;
        }

        .tab {
            flex: 1;
            padding: 9px 6px;
            text-align: center;
            cursor: pointer;
            border: none;
            background: transparent;
            border-radius: 9px;
            transition: all 0.2s ease;
            font-weight: 600;
            font-size: 0.8rem;
            color: #475569;
        }

        .tab:hover {
            color: #1e3a8a;
            background: rgba(255, 255, 255, 0.55);
        }

        .tab.active {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #334155;
            font-size: 0.8rem;
        }

        .form-group input[type="number"],
        .form-group select {
            width: 100%;
            padding: 9px 11px;
            border: 1.5px solid #cbd5e1;
            border-radius: 9px;
            font-size: 0.86rem;
            transition: all 0.2s ease;
            background: #ffffff;
            color: #0f172a;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);
        }

        .form-group input.input-invalid {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .btn {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
            color: white;
            border: none;
            padding: 9px 14px;
            border-radius: 9px;
            font-size: 0.82rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(30, 64, 175, 0.25);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(30, 64, 175, 0.35);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn.active-view {
            background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.6);
        }

        .btn-primary {
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
            font-size: 0.95rem;
            padding: 12px 20px;
            width: 100%;
            border-radius: 11px;
            box-shadow: 0 6px 18px rgba(220, 38, 38, 0.3);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            font-size: 0.88rem;
            padding: 10px 16px;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);
        }

        .btn-slate {
            background: linear-gradient(135deg, #334155 0%, #475569 100%);
            box-shadow: 0 4px 12px rgba(51, 65, 85, 0.25);
        }

        .btn-pdf {
            background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%);
            box-shadow: 0 5px 15px rgba(79, 70, 229, 0.32);
        }

        .btn-pdf:disabled {
            opacity: 0.65;
            cursor: wait;
            transform: none;
        }

        .action-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .report-details {
            margin-top: 14px;
            margin-bottom: 12px;
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 11px;
            padding: 9px 12px;
        }

        .report-details summary {
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 700;
            color: #1e3a8a;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            user-select: none;
        }

        .report-details summary::-webkit-details-marker {
            display: none;
        }

        .report-details summary::after {
            content: '▾';
            font-size: 0.9rem;
            color: #64748b;
            transition: transform 0.2s ease;
        }

        .report-details[open] summary::after {
            transform: rotate(180deg);
        }

        .report-details-body {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #e2e8f0;
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .report-details-body .form-group {
            margin-bottom: 0;
        }

        .report-details-body input[type="text"] {
            width: 100%;
            padding: 7px 10px;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            font-size: 0.82rem;
            background: #ffffff;
            color: #0f172a;
        }

        .report-details-body input[type="text"]:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);
        }

        #threejs-container, #twod-container {
            width: 100%;
            flex: 1;
            border-radius: 14px;
            overflow: hidden;
            position: relative;
            min-height: 700px;
            border: 1.5px solid rgba(148, 163, 184, 0.25);
        }

        #threejs-container {
            background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
            touch-action: none;
        }

        #twod-container {
            background: #f8fafc;
            display: none;
        }

        #motor2d-canvas {
            width: 100%;
            height: 100%;
            display: block;
            cursor: crosshair;
        }

        .viewer-controls {
            position: absolute;
            top: 14px;
            left: 14px;
            z-index: 20;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .viewer-controls .btn {
            background: rgba(15, 23, 42, 0.82);
            border: 1px solid rgba(148, 163, 184, 0.3);
            backdrop-filter: blur(8px);
            padding: 8px 11px;
            font-size: 0.78rem;
        }

        .viewer-controls .btn:hover {
            background: rgba(37, 99, 235, 0.9);
        }

        .view-controls {
            position: absolute;
            top: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 25;
            display: flex;
            gap: 8px;
            background: rgba(15, 23, 42, 0.85);
            padding: 7px 10px;
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            backdrop-filter: blur(10px);
        }

        .status-indicator {
            position: absolute;
            bottom: 24px;
            right: 24px;
            background: rgba(15, 23, 42, 0.86);
            color: #e2e8f0;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 0.76rem;
            line-height: 1.5;
            z-index: 25;
            border: 1px solid rgba(148, 163, 184, 0.25);
            backdrop-filter: blur(8px);
        }

        .phase-legend-3d {
            position: absolute;
            bottom: 24px;
            left: 24px;
            background: rgba(15, 23, 42, 0.86);
            color: #e2e8f0;
            padding: 9px 13px;
            border-radius: 10px;
            font-size: 0.75rem;
            z-index: 25;
            border: 1px solid rgba(148, 163, 184, 0.25);
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .legend-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 4px;
        }

        .result-card {
            background: #ffffff;
            border-radius: 13px;
            padding: 15px;
            margin-bottom: 14px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
            border: 1px solid #e2e8f0;
            border-left: 5px solid #2563eb;
        }

        .result-card h3 {
            font-size: 0.96rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
        }

        .result-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .result-item {
            background: #f8fafc;
            padding: 10px 8px;
            border-radius: 9px;
            text-align: center;
            border: 1px solid #e2e8f0;
            transition: transform 0.15s ease;
        }

        .result-item:hover {
            transform: translateY(-1px);
            border-color: #93c5fd;
        }

        .result-label {
            font-size: 0.74rem;
            color: #64748b;
            font-weight: 500;
        }

        .result-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1e40af;
            display: block;
            margin-top: 3px;
        }

        .charts-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .chart-container {
            background: #ffffff;
            border-radius: 12px;
            padding: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
            height: 255px;
            position: relative;
        }

        .span-selection {
            margin: 10px 0 14px;
            padding: 12px;
            background: #f1f5f9;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
        }

        .span-info {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

        .span-detail {
            text-align: center;
            padding: 8px;
            background: white;
            border-radius: 7px;
            font-size: 0.78rem;
            border: 1px solid #e2e8f0;
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
        }

        .comparison-table th,
        .comparison-table td {
            padding: 9px 6px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.76rem;
        }

        .comparison-table th {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: white;
            font-weight: 600;
        }

        .comparison-table tbody tr {
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .comparison-table tbody tr:hover {
            background: rgba(59, 130, 246, 0.08);
        }

        .comparison-table tbody tr.span-active {
            background: rgba(37, 99, 235, 0.14);
            font-weight: 700;
            color: #1e3a8a;
        }

        .comparison-table tbody tr.span-optimal {
            border-left: 4px solid #10b981;
        }

        .alert {
            padding: 10px 12px;
            margin: 8px 0;
            border-radius: 9px;
            border-left: 4px solid;
            font-size: 0.8rem;
            line-height: 1.45;
        }

        .alert-info {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #1e40af;
        }

        .alert-success {
            background: #ecfdf5;
            border-color: #10b981;
            color: #065f46;
        }

        .alert-warning {
            background: #fffbeb;
            border-color: #f59e0b;
            color: #92400e;
        }

        .alert-danger {
            background: #fef2f2;
            border-color: #ef4444;
            color: #991b1b;
        }

        .industrial-badge {
            background: linear-gradient(135deg, #059669, #10b981);
            color: white;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.03em;
        }

        .badge-warn {
            background: linear-gradient(135deg, #d97706, #f59e0b);
        }

        .badge-danger {
            background: linear-gradient(135deg, #dc2626, #ef4444);
        }

        .badge-blue {
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        }

        .hidden {
            display: none !important;
        }

        /* Toast notification (replaces alert()) */
        #toast-container {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }

        .toast-msg {
            background: rgba(15, 23, 42, 0.94);
            color: #f8fafc;
            padding: 11px 20px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(56, 189, 248, 0.4);
            animation: fadeInToast 0.25s ease;
        }

        @keyframes fadeInToast {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 1380px) {
            .main-layout {
                grid-template-columns: 350px 1fr;
            }
            #analysis-panel {
                grid-column: 1 / -1;
                max-height: none;
            }
            .charts-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 920px) {
            .main-layout {
                grid-template-columns: 1fr;
            }
            .panel {
                max-height: none;
            }
            .viewer-panel {
                height: 620px;
                min-height: 580px;
            }
            #threejs-container, #twod-container {
                min-height: 540px;
            }
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Fallback Print Stylesheet (if jsPDF CDN is unavailable) */
        @media print {
            body {
                background: #ffffff !important;
                color: #0f172a !important;
            }
            .header-banner {
                background: #0f172a !important;
                color: #ffffff !important;
                box-shadow: none !important;
                padding: 16px !important;
                margin-bottom: 12px !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .header-banner h1 {
                -webkit-text-fill-color: #ffffff !important;
                font-size: 1.5rem !important;
            }
            .main-layout {
                display: block !important;
            }
            .panel {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                max-height: none !important;
                overflow: visible !important;
                margin-bottom: 16px !important;
                page-break-inside: avoid;
            }
            #control-panel,
            .tabs,
            .view-controls,
            .viewer-controls,
            .status-indicator,
            #toast-container {
                display: none !important;
            }
            .tab-content.hidden {
                display: block !important;
            }
            .viewer-panel {
                height: 460px !important;
                min-height: 460px !important;
            }
            .charts-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
            .chart-container {
                page-break-inside: avoid;
                height: 220px !important;
            }
        }
    </style>
</head>
<body>
    <div id="toast-container"></div>

    <div class="container-app">
        <header class="header-banner">
            <h1>⚡ Industrial Motor Winding Design Calculator</h1>
            <p>IEC 60034 &amp; NEMA MG-1 Compliant &mdash; Physics-Driven Loss Modeling, Harmonic MMF Analysis &amp; 3D/2D Pole-Phase Visualization</p>
        </header>

        <main class="main-layout">
            <!-- LEFT: Control Panel -->
            <section class="panel" id="control-panel">
                <h2 class="section-title">
                    <span>⚙️ Motor Design Parameters</span>
                </h2>

                <!-- Inline Validation Alerts Container -->
                <div id="validation-alerts"></div>

                <div class="tabs">
                    <button type="button" class="tab active" onclick="switchControlTab('basic', this)">Basic</button>
                    <button type="button" class="tab" onclick="switchControlTab('advanced', this)">Advanced</button>
                    <button type="button" class="tab" onclick="switchControlTab('losses', this)">Losses</button>
                    <button type="button" class="tab" onclick="switchControlTab('standards', this)">Standards</button>
                </div>

                <!-- Basic Parameters -->
                <div id="basic-tab" class="tab-content">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="slots">Stator Slots (S):</label>
                            <input type="number" id="slots" min="6" max="144" value="36" step="3" onchange="calculateMotorDesign()">
                        </div>
                        <div class="form-group">
                            <label for="poles">Number of Poles (P):</label>
                            <input type="number" id="poles" min="2" max="16" value="4" step="2" onchange="calculateMotorDesign()">
                        </div>
                        <div class="form-group">
                            <label for="phases">Phases (m):</label>
                            <select id="phases" onchange="calculateMotorDesign()">
                                <option value="3" selected>3-Phase</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="power">Shaft Power P<sub>out</sub> (kW):</label>
                            <input type="number" id="power" min="0.37" max="500" value="7.5" step="0.25" onchange="calculateMotorDesign()">
                        </div>
                        <div class="form-group">
                            <label for="voltage">Line Voltage V<sub>L</sub> (V):</label>
                            <select id="voltage" onchange="calculateMotorDesign()">
                                <option value="230">230V (IEC Low)</option>
                                <option value="400" selected>400V (IEC Standard)</option>
                                <option value="460">460V (NEMA Standard)</option>
                                <option value="690">690V (IEC High)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="frequency">Frequency (Hz):</label>
                            <select id="frequency" onchange="calculateMotorDesign()">
                                <option value="50" selected>50 Hz (IEC)</option>
                                <option value="60">60 Hz (NEMA)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Advanced Parameters -->
                <div id="advanced-tab" class="tab-content hidden">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="wireDiameter">Wire Diameter (mm):</label>
                            <input type="number" id="wireDiameter" min="0.3" max="6.0" value="1.8" step="0.05" onchange="calculateMotorDesign()">
                        </div>
                        <div class="form-group">
                            <label for="turnsPerCoil">Turns per Coil:</label>
                            <input type="number" id="turnsPerCoil" min="4" max="300" value="42" step="1" onchange="calculateMotorDesign()">
                        </div>
                        <div class="form-group">
                            <label for="parallelPaths">Parallel Paths (a):</label>
                            <select id="parallelPaths" onchange="calculateMotorDesign()">
                                <option value="1">1 (Series)</option>
                                <option value="2" selected>2 (2-Parallel)</option>
