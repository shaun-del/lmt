        function ensureBatchInputsLength(count) {
            while (state.batchInputs.length < count) {
                const clone = state.batchInputs.length > 0
                    ? { ...state.batchInputs[0] }
                    : createDefaultMotorInput();
                state.batchInputs.push(clone);
            }
            if (state.batchInputs.length > count) {
                state.batchInputs = state.batchInputs.slice(0, count);
            }
            if (state.activeBatchTab >= count) {
                state.activeBatchTab = count - 1;
            }
        }

