        /**
         * IEC 60034-1 Altitude & Ambient Temperature Derating Factors
         */
        function calculateDerating(ambientTempC, altitudeM, insulationClass) {
            // Altitude derating: 1.0 up to 1000m; above 1000m, 1% per 100m, floored at 0.60
            let kAlt = 1.0;
            if (altitudeM > 1000) {
                kAlt = Math.max(0.60, 1.0 - ((altitudeM - 1000) / 100) * 0.01);
            }

            // Temperature derating rates above 40°C per Insulation Class
            const tempRates = { B: 0.010, F: 0.0085, H: 0.0070 };
            const rate = tempRates[insulationClass] || 0.0085;

            let kTemp = 1.0;
            if (ambientTempC > 40) {
                kTemp = Math.max(0.55, 1.0 - (ambientTempC - 40) * rate);
            } else if (ambientTempC < 40) {
                // Slight uprating below 40°C, capped at 1.05
                kTemp = Math.min(1.05, 1.0 + (40 - ambientTempC) * 0.0025);
            }

            const kTotal = kTemp * kAlt;
            return {
                kAlt: Number(kAlt.toFixed(4)),
                kTemp: Number(kTemp.toFixed(4)),
                kTotal: Number(kTotal.toFixed(4))
            };
        }

        /**
         * Strict Validation for a single motor design input
         */
        function validateMotorInput(input, db, motorLabel = 'Motor #1') {
            const errors = [];
            if (!db || db.length === 0) {
                errors.push('Active motor database is empty. Please load sample data or add a motor.');
            }
            if (isNaN(input.powerKw) || input.powerKw <= 0 || input.powerKw > 5000) {
                errors.push(`${motorLabel}: Output Power must be > 0 and ≤ 5000 kW.`);
            }
            if (isNaN(input.voltageV) || input.voltageV < 100 || input.voltageV > 11000) {
                errors.push(`${motorLabel}: Voltage must be between 100 V and 11,000 V.`);
            }
            if (isNaN(input.frequencyHz) || input.frequencyHz < 10 || input.frequencyHz > 400) {
                errors.push(`${motorLabel}: Frequency must be between 10 Hz and 400 Hz.`);
            }
            if (![2, 4, 6, 8].includes(Number(input.poles))) {
                errors.push(`${motorLabel}: Poles must be 2, 4, 6, or 8.`);
            }
            if (isNaN(input.ambientTempC) || input.ambientTempC < -20 || input.ambientTempC > 80) {
                errors.push(`${motorLabel}: Ambient Temperature must be between -20°C and 80°C.`);
            }
            if (!['B', 'F', 'H'].includes(input.insulationClass)) {
                errors.push(`${motorLabel}: Insulation Class must be B, F, or H.`);
            }
            if (!['Star', 'Delta'].includes(input.connection)) {
                errors.push(`${motorLabel}: Connection must be Star or Delta.`);
            }
            if (isNaN(input.altitudeM) || input.altitudeM < 0 || input.altitudeM > 5000) {
                errors.push(`${motorLabel}: Altitude must be between 0 m and 5,000 m.`);
            }
            if (input.fixedDimensions) {
                const frameTrimmed = String(input.frameSize || '').trim();
                if (!frameTrimmed) {
                    errors.push(`${motorLabel}: Frame Size is required when Fixed Dimensions is checked.`);
                } else if (db && db.length > 0) {
                    const match = db.find(m => String(m.frameSize).toLowerCase() === frameTrimmed.toLowerCase());
                    if (!match) {
                        errors.push(`${motorLabel}: Frame Size "${frameTrimmed}" was not found in the active motor database.`);
                    }
                }
            }
            return { valid: errors.length === 0, errors };
        }

        /**
         * Find best matching reference motor in active database
         */
        function findReferenceMotor(input, pEqKw, db) {
            if (input.fixedDimensions) {
                const targetFrame = String(input.frameSize).trim().toLowerCase();
                const frameMatches = db.filter(m => String(m.frameSize).toLowerCase() === targetFrame);
                if (frameMatches.length === 0) return null;
                // Prefer matching poles, then nearest power
                return frameMatches.sort((a, b) => {
                    const poleDiffA = a.poles === input.poles ? 0 : 1;
                    const poleDiffB = b.poles === input.poles ? 0 : 1;
                    if (poleDiffA !== poleDiffB) return poleDiffA - poleDiffB;
                    return Math.abs(Math.log(pEqKw / a.powerKw)) - Math.abs(Math.log(pEqKw / b.powerKw));
                })[0];
            }

            // Prefer matching poles if available
            const samePoleMotors = db.filter(m => Number(m.poles) === Number(input.poles));
            const pool = samePoleMotors.length > 0 ? samePoleMotors : db;

            return pool.slice().sort((a, b) => {
                return Math.abs(Math.log(pEqKw / a.powerKw)) - Math.abs(Math.log(pEqKw / b.powerKw));
            })[0];
        }

        /**
         * Clamp utility
         */
        function clamp(val, min, max) {
            return Math.min(max, Math.max(min, val));
        }

        /**
         * Core First-Principles Motor Redesign Calculation
         */
        function designSingleMotor(input, db) {
            const derating = calculateDerating(input.ambientTempC, input.altitudeM, input.insulationClass);
            const pEqKw = input.powerKw / derating.kTotal;

            const base = findReferenceMotor(input, pEqKw, db);
            if (!base) {
                throw new Error('No matching reference motor found in active database.');
            }

            const warnings = [];
            const sqrt3 = Math.sqrt(3);

            // Synchronous speeds (rps & RPM)
            const nsBaseRps = (2 * base.frequencyHz) / base.poles;
            const nsNewRps = (2 * input.frequencyHz) / input.poles;
            const nsNewRpm = (120 * input.frequencyHz) / input.poles;

            // Apparent power (kVA)
            const sBaseKva = base.powerKw / ((base.efficiencyPct / 100) * base.powerFactor);
            const sEqKva = pEqKw / ((base.efficiencyPct / 100) * base.powerFactor);

            // Geometry in meters
            const diM = base.innerDiameterMm / 1000;
            const lBaseM = base.coreLengthMm / 1000;

            // Standard Output Coefficient Co (kVA / (m^3 * rps))
            const coStd = sBaseKva / (diM * diM * lBaseM * nsBaseRps);
            const coAdjusted = coStd * (1 / derating.kTotal);

            // Core length scaling
            let lNewMm = base.coreLengthMm;
            if (!input.fixedDimensions) {
                const rawLengthMm = base.coreLengthMm * (pEqKw / base.powerKw) * (base.frequencyHz / input.frequencyHz) * (input.poles / base.poles);
                const minL = 0.7 * base.coreLengthMm;
                const maxL = 1.4 * base.coreLengthMm;
                lNewMm = clamp(rawLengthMm, minL, maxL);

                if (rawLengthMm > maxL) {
                    warnings.push({
                        type: 'geometry',
                        severity: 'warning',
                        message: `Ideal core length (${rawLengthMm.toFixed(1)} mm) exceeded 1.4× base length; clamped to ${lNewMm.toFixed(1)} mm. Consider a larger frame.`
                    });
                } else if (rawLengthMm < minL) {
                    warnings.push({
                        type: 'geometry',
                        severity: 'info',
                        message: `Ideal core length (${rawLengthMm.toFixed(1)} mm) was below 0.7× base length; clamped to ${lNewMm.toFixed(1)} mm.`
                    });
                }
            }

            const lNewM = lNewMm / 1000;
            const coActual = sEqKva / (diM * diM * lNewM * nsNewRps);

            // Thermal overload & under-utilization checks
            if (coActual > 1.15 * coStd) {
                const overloadPct = ((coActual / coStd - 1) * 100).toFixed(1);
                warnings.push({
                    type: 'thermal',
                    severity: 'danger',
                    message: `Thermal Overload Warning: Actual Co (${coActual.toFixed(1)}) exceeds 115% of Standard Co (${coStd.toFixed(1)}) by +${overloadPct}%. Frame ${base.frameSize} may overheat.`
                });
            } else if (coActual < 0.70 * coStd) {
                warnings.push({
                    type: 'utilization',
                    severity: 'info',
                    message: `Low Frame Utilization: Actual Co (${coActual.toFixed(1)}) is below 70% of Standard Co (${coStd.toFixed(1)}). A smaller frame may be more economical.`
                });
            }

            if (derating.kTotal < 0.999) {
                warnings.push({
                    type: 'derating',
                    severity: 'warning',
                    message: `IEC 60034-1 Derating Applied: Combined factor ${(derating.kTotal * 100).toFixed(1)}% (k_temp=${derating.kTemp.toFixed(3)}, k_alt=${derating.kAlt.toFixed(3)}). Thermal equivalent load = ${pEqKw.toFixed(2)} kW.`
                });
            }

            // Phase voltages (Star vs Delta)
            const vPhBase = base.connection === 'Star' ? base.voltageV / sqrt3 : base.voltageV;
            const vPhNew = input.connection === 'Star' ? input.voltageV / sqrt3 : input.voltageV;

            // Exact turns per phase (V/f & core length scaling)
            const exactTurns = base.turnsPerPhase * (vPhNew / vPhBase) * (base.frequencyHz / input.frequencyHz) * (base.coreLengthMm / lNewMm);

            // Generate 3 distinct positive integer turn options
            const roundedCenter = Math.round(exactTurns);
            let turnCandidates;
            if (roundedCenter <= 1) {
                turnCandidates = [1, 2, 3];
            } else {
                turnCandidates = [roundedCenter, roundedCenter - 1, roundedCenter + 1];
            }

            // Base full-load line & phase currents
            const iLineBase = (base.powerKw * 1000) / (sqrt3 * base.voltageV * (base.efficiencyPct / 100) * base.powerFactor);
            const iPhBase = base.connection === 'Star' ? iLineBase : iLineBase / sqrt3;

            // Target full-load line & phase currents (using base eta/pf as initial estimate)
            const iLineNewEst = (input.powerKw * 1000) / (sqrt3 * input.voltageV * (base.efficiencyPct / 100) * base.powerFactor);
            const iPhNew = input.connection === 'Star' ? iLineNewEst : iLineNewEst / sqrt3;

            // Conductor area preserving base current density
            const conductorAreaNew = base.conductorAreaMm2 * (iPhNew / iPhBase);
            const baseCopperArea = base.turnsPerPhase * base.conductorAreaMm2;

            // Evaluate each turn option
            const options = turnCandidates.map((turnsOpt) => {
                const deltaTurns = turnsOpt - exactTurns;
                const bRatio = exactTurns / turnsOpt; // Flux density ratio (B_new / B_base)

                // Slot fill ratio relative to base motor
                const slotFillRatio = (turnsOpt * conductorAreaNew) / baseCopperArea;
                const slotFillWarning = slotFillRatio > 1.15;

                // Nonlinear magnetic saturation for no-load current (I0 ~ B^2.5)
                const noLoadCurrentNew = base.noLoadCurrentA * (input.powerKw / base.powerKw) * (base.voltageV / input.voltageV) * Math.pow(bRatio, 2.5);

                // Starting torque & starting current (~ B^2)
                const startingTorquePct = base.startingTorquePct * Math.pow(bRatio, 2);
                const startingCurrentPct = base.startingCurrentPct * Math.pow(bRatio, 2);

                // Efficiency & Power Factor adjustments
                const fluxDeviation = Math.abs(bRatio - 1);
                const fluxPenalty = Math.pow(fluxDeviation, 2) * 18 + (bRatio > 1 ? (bRatio - 1) * 4.5 : (1 - bRatio) * 2.5);
                const loadPenalty = Math.max(0, (coActual / coStd - 1.05) * 6.0);
                const scaleBonus = input.powerKw >= base.powerKw ? 0.2 : -0.2;
                const efficiencyPct = clamp(base.efficiencyPct - fluxPenalty - loadPenalty + scaleBonus, 50.0, 97.5);

                const pfFluxAdj = bRatio > 1 ? -(bRatio - 1) * 0.25 : (1 - bRatio) * 0.04;
                const pfLoadPenalty = Math.max(0, (coActual / coStd - 1.15) * 0.08);
                const powerFactor = clamp(base.powerFactor + pfFluxAdj - pfLoadPenalty, 0.45, 0.96);

                // Composite performance score (0.00 to 1.00)
                const fluxScore = Math.exp(-6.0 * Math.pow(bRatio - 1, 2));
                const effScore = efficiencyPct / 100;
                const pfScore = powerFactor;
                const startTorqueScore = startingTorquePct >= 150
                    ? clamp(1.0 - Math.max(0, (startingCurrentPct - 750) / 800), 0.4, 1.0)
                    : clamp(startingTorquePct / 150, 0.2, 1.0);

                let score = (0.40 * fluxScore) + (0.25 * effScore) + (0.20 * pfScore) + (0.15 * startTorqueScore);
                if (coActual > 1.15 * coStd) score -= 0.12;
                if (slotFillWarning) score -= 0.08;
                score = clamp(score, 0.0, 1.0);

                return {
                    turns: turnsOpt,
                    deltaFromExact: deltaTurns,
                    bRatio,
                    conductorAreaMm2: conductorAreaNew,
                    slotFillRatio,
                    slotFillWarning,
                    coreLengthMm: lNewMm,
                    fullLoadLineCurrentA: iLineNewEst,
                    fullLoadPhaseCurrentA: iPhNew,
                    noLoadCurrentA: noLoadCurrentNew,
                    startingTorquePct,
                    startingCurrentPct,
                    efficiencyPct,
                    powerFactor,
                    performanceScore: score,
                    recommended: false
                };
            });

            // Sort options by composite performance score descending & mark best
            options.sort((a, b) => b.performanceScore - a.performanceScore);
            options[0].recommended = true;

            if (options[0].slotFillWarning) {
                warnings.push({
                    type: 'slotfill',
                    severity: 'warning',
                    message: `Slot Fill Warning: Recommended winding copper area is ${(options[0].slotFillRatio * 100).toFixed(1)}% of base frame slot fill (>115%). Verify slot geometry.`
                });
            }

            return {
                input: { ...input },
                baseMotor: { ...base },
                derating,
                pEqKw,
                deratedBaseCapacityKw: base.powerKw * derating.kTotal,
                nsNewRpm,
                coStd,
                coAdjusted,
                coActual,
                coreLengthNewMm: lNewMm,
                exactTurns,
                warnings,
                options
            };
        }

        /**
         * RFC 4180 CSV Escaping & Export String Builder
         */
        function escapeCsvCell(value) {
            const str = value === null || value === undefined ? '' : String(value);
            if (/[",\n\r]/.test(str)) {
                return `"${str.replace(/"/g, '""')}"`;
            }
            return str;
        }

        function buildResultsCsv(batchResults) {
            const headers = [
                'Motor #', 'Target Power (kW)', 'Voltage (V)', 'Frequency (Hz)', 'Poles', 'Sync Speed (RPM)',
                'Connection', 'Ambient Temp (C)', 'Insulation Class', 'Altitude (m)', 'Fixed Dimensions',
                'k_temp', 'k_alt', 'Thermal Eq Power (kW)', 'Ref Frame Size', 'Ref Power (kW)',
                'Co Std', 'Co Actual', 'Option Rank', 'Recommended', 'Turns/Phase', 'Delta From Exact',
                'Flux Ratio (B/B0)', 'Conductor Area (mm2)', 'Slot Fill Ratio (%)', 'Core Length (mm)',
                'Full-Load Current (A)', 'No-Load Current (A)', 'Start Torque (%)', 'Start Current (%)',
                'Efficiency (%)', 'Power Factor', 'Performance Score', 'Warnings'
            ];

            const rows = [headers.map(escapeCsvCell).join(',')];

            batchResults.motors.forEach((m, idx) => {
                const warningText = m.warnings.map(w => w.message).join(' | ') || 'None';
                m.options.forEach((opt, optIdx) => {
                    const row = [
                        `Motor #${idx + 1}`,
                        m.input.powerKw,
                        m.input.voltageV,
                        m.input.frequencyHz,
                        m.input.poles,
                        m.nsNewRpm.toFixed(0),
                        m.input.connection,
                        m.input.ambientTempC,
                        m.input.insulationClass,
                        m.input.altitudeM,
                        m.input.fixedDimensions ? 'Yes' : 'No',
                        m.derating.kTemp.toFixed(3),
                        m.derating.kAlt.toFixed(3),
                        m.pEqKw.toFixed(2),
                        m.baseMotor.frameSize,
                        m.baseMotor.powerKw,
                        m.coStd.toFixed(2),
                        m.coActual.toFixed(2),
                        `Option ${optIdx + 1}`,
                        opt.recommended ? 'Yes' : 'No',
                        opt.turns,
                        opt.deltaFromExact.toFixed(2),
                        opt.bRatio.toFixed(3),
                        opt.conductorAreaMm2.toFixed(3),
                        (opt.slotFillRatio * 100).toFixed(1),
                        opt.coreLengthMm.toFixed(1),
                        opt.fullLoadLineCurrentA.toFixed(2),
                        opt.noLoadCurrentA.toFixed(2),
                        opt.startingTorquePct.toFixed(1),
                        opt.startingCurrentPct.toFixed(1),
                        opt.efficiencyPct.toFixed(2),
                        opt.powerFactor.toFixed(3),
                        opt.performanceScore.toFixed(3),
                        warningText
                    ];
                    rows.push(row.map(escapeCsvCell).join(','));
                });
            });

            return rows.join('\n');
        }

        /* =========================================================================
           4. UI HELPERS & TOAST NOTIFICATIONS (NO alert() OR confirm())
           ========================================================================= */
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const colors = {
                success: 'bg-emerald-900/95 border-emerald-500/60 text-emerald-100',
                error: 'bg-rose-900/95 border-rose-500/60 text-rose-100',
                warning: 'bg-amber-900/95 border-amber-500/60 text-amber-100',
                info: 'bg-slate-800/95 border-sky-500/60 text-sky-100'
            };
            const icons = {
                success: 'fa-check-circle text-emerald-400',
                error: 'fa-times-circle text-rose-400',
                warning: 'fa-exclamation-triangle text-amber-400',
                info: 'fa-info-circle text-sky-400'
            };

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-start gap-3 px-4 py-3 rounded-xl border shadow-xl text-sm fade-in ${colors[type] || colors.info}`;
            toast.innerHTML = `
                <i class="fas ${icons[type] || icons.info} mt-0.5"></i>
                <span class="flex-1">${escapeHtml(message)}</span>
                <button type="button" class="text-slate-400 hover:text-white cursor-pointer" onclick="this.parentElement.remove()">
                    <i class="fas fa-times text-xs"></i>
                </button>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                if (toast.parentElement) toast.remove();
            }, 4500);
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        /* =========================================================================
           5. DATABASE TABLE & FRAME SELECTOR RENDERING
           ========================================================================= */
        function renderDatabaseTable() {
            const tbody = document.getElementById('db-table-body');
            const countBadge = document.getElementById('db-count-badge');
            const restoreBtn = document.getElementById('restore-db-btn');

            countBadge.textContent = state.motorDb.length;
            const hasChanges = state.motorDb.length !== DEFAULT_MOTOR_DB.length || state.motorDb.some(m => !m.isDefault);
            restoreBtn.classList.toggle('hidden', !hasChanges);

            if (state.motorDb.length === 0) {
                tbody.innerHTML = `<tr><td colspan="11" class="py-6 text-center text-slate-400">No motors in active database. Add a motor or restore defaults.</td></tr>`;
                return;
            }

            tbody.innerHTML = state.motorDb.map((m) => `
                <tr class="hover:bg-slate-800/60 transition">
                    <td class="py-2.5 px-3 font-semibold text-sky-300">
                        ${escapeHtml(m.frameSize)}
                        ${m.isDefault ? '' : '<span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Custom</span>'}
                    </td>
                    <td class="py-2.5 px-3 font-medium">${m.powerKw}</td>
                    <td class="py-2.5 px-3 text-slate-300">${m.voltageV}V / ${m.frequencyHz}Hz / ${m.poles}P</td>
                    <td class="py-2.5 px-3">${escapeHtml(m.connection)}</td>
