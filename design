<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3-Phase Induction Motor Design Calculator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Roboto -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- SheetJS for real Excel/CSV parsing -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

    <style>
        /* Fixed CSS Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Roboto', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f1f5f9;
            min-height: 100vh;
            line-height: 1.6;
        }

        /* Frosted Glass Engineering Card */
        .glass-card {
            background: rgba(30, 41, 59, 0.72);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(148, 163, 184, 0.16);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.45);
        }

        /* Explicit dark styling for select & option across all browsers */
        select,
        select option {
            background-color: #1e293b !important;
            color: #f8fafc !important;
        }

        select:focus,
        input:focus {
            outline: none;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
        }

        /* Custom sleek scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Spinner animation */
        .spinner {
            border: 4px solid rgba(148, 163, 184, 0.25);
            border-top: 4px solid #38bdf8;
            border-radius: 50%;
            width: 42px;
            height: 42px;
            animation: spin 0.85s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Fade in animation */
        .fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="p-3 sm:p-6 lg:p-8 antialiased selection:bg-sky-500/30 selection:text-sky-200">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Header & Toolbar -->
        <header class="glass-card rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b-2 border-sky-500/40">
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-400 shrink-0">
                    <i class="fas fa-cogs text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                        3-Phase Induction Motor Design Calculator
                    </h1>
                    <p class="text-sm sm:text-base text-slate-400 mt-0.5">
                        IEC 60034-1 Derating, Output Coefficient (<span class="italic">C<sub>o</sub></span>) Scaling &amp; Winding Redesign Engine
                    </p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button id="run-tests-btn" type="button" class="px-4 py-2.5 rounded-xl bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-400/40 text-indigo-200 font-medium text-sm transition flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-vial"></i> Run Automated Tests
                </button>
            </div>
        </header>

        <!-- Section 1: Data Source Management -->
        <section class="glass-card rounded-2xl p-5 sm:p-6 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-700/80">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center">
                        <i class="fas fa-database"></i>
                    </div>
                    <div>
                        <h2 class="text-lg sm:text-xl font-semibold text-white">Reference Motor Database</h2>
                        <p class="text-xs text-slate-400">Select built-in IEC frames, add custom motors, or import Excel/CSV sheets</p>
                    </div>
                </div>
                <button id="toggle-db-btn" type="button" class="px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600/70 text-slate-200 text-xs sm:text-sm font-medium transition flex items-center gap-2 self-start sm:self-auto cursor-pointer">
                    <i class="fas fa-table text-sky-400"></i>
                    <span>View Active Motor Database (<span id="db-count-badge">8</span>)</span>
                    <i id="toggle-db-chevron" class="fas fa-chevron-down text-xs transition-transform"></i>
                </button>
            </div>

            <!-- Data Source Selector & Status -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-start">
                <div>
                    <label for="data-source" class="block text-sm font-medium text-slate-300 mb-1.5">Data Source Mode</label>
                    <select id="data-source" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-600/80 bg-slate-800 text-slate-100 text-sm">
                        <option value="sample">Built-in IEC Sample Database (8 Motors)</option>
                        <option value="manual">Add Custom Motor Manually</option>
                        <option value="upload">Upload Excel / CSV Database (.xlsx, .xls, .csv)</option>
                    </select>
                </div>

                <!-- Upload Mode Panel -->
                <div id="upload-section" class="hidden lg:col-span-2 bg-slate-900/60 border border-slate-700/80 rounded-xl p-4 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
                        <div class="flex-1">
                            <label for="excel-file" class="block text-xs font-medium text-slate-300 mb-1.5">
                                Choose Excel or CSV File <span class="text-slate-400">(Columns: frameSize, powerKw, voltageV, frequencyHz, poles, connection, efficiencyPct, powerFactor, innerDiameterMm, coreLengthMm, turnsPerPhase, conductorAreaMm2, noLoadCurrentA, startingTorquePct, startingCurrentPct)</span>
                            </label>
                            <input type="file" id="excel-file" accept=".xlsx,.xls,.csv" class="w-full text-xs text-slate-300 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-500/20 file:text-sky-300 hover:file:bg-sky-500/30 bg-slate-800/80 rounded-lg border border-slate-700 p-1.5 cursor-pointer">
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button id="upload-btn" type="button" class="px-4 py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs transition flex items-center gap-1.5 cursor-pointer">
                                <i class="fas fa-upload"></i> Import File
                            </button>
                            <button id="download-template-btn" type="button" class="px-3.5 py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 font-medium text-xs transition flex items-center gap-1.5 cursor-pointer">
                                <i class="fas fa-file-csv text-emerald-400"></i> Download CSV Template
                            </button>
                        </div>
                    </div>
                    <div id="upload-error" class="hidden text-xs text-rose-300 bg-rose-500/10 border border-rose-500/30 rounded-lg p-2.5"></div>
                </div>

                <!-- Status Bar (when not in upload mode or below) -->
                <div id="status-wrapper" class="lg:col-span-2 flex items-center justify-between gap-3 bg-slate-900/50 border border-slate-700/70 rounded-xl px-4 py-3 mt-0 lg:mt-6">
                    <div class="flex items-center gap-2.5 text-sm text-slate-200">
                        <i id="data-status-icon" class="fas fa-check-circle text-emerald-400 text-base"></i>
                        <span id="data-status-text">Sample IEC database active. 8 standard 3-phase motors loaded (0.75 kW – 15 kW).</span>
                    </div>
                    <button id="restore-db-btn" type="button" class="hidden shrink-0 text-xs px-2.5 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 transition cursor-pointer">
                        <i class="fas fa-undo mr-1"></i> Restore Defaults
                    </button>
                </div>
            </div>

            <!-- Manual Motor Add Form -->
            <div id="manual-section" class="hidden bg-slate-900/60 border border-slate-700/80 rounded-xl p-4 sm:p-5 space-y-4 fade-in">
                <div class="flex items-center justify-between border-b border-slate-700/70 pb-2.5">
                    <h3 class="text-sm font-semibold text-sky-300 flex items-center gap-2">
                        <i class="fas fa-plus-circle"></i> Add Custom Reference Motor to Active Database
                    </h3>
                    <span class="text-xs text-slate-400">All fields required &amp; validated</span>
                </div>
                <div id="manual-error" class="hidden text-xs text-rose-300 bg-rose-500/10 border border-rose-500/30 rounded-lg p-3"></div>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Frame Size</label>
                        <input id="m-frame" type="text" placeholder="e.g., 160L" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Power (kW)</label>
                        <input id="m-power" type="number" step="0.01" min="0.1" placeholder="18.5" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Voltage (V)</label>
                        <input id="m-voltage" type="number" step="1" min="100" value="415" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Frequency (Hz)</label>
                        <input id="m-freq" type="number" step="0.1" min="10" value="50" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Poles</label>
                        <select id="m-poles" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                            <option value="2">2 Poles</option>
                            <option value="4" selected>4 Poles</option>
                            <option value="6">6 Poles</option>
                            <option value="8">8 Poles</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Connection</label>
                        <select id="m-conn" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                            <option value="Star">Star</option>
                            <option value="Delta" selected>Delta</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Efficiency (%)</label>
                        <input id="m-eff" type="number" step="0.1" min="50" max="99" placeholder="91.5" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Power Factor</label>
                        <input id="m-pf" type="number" step="0.01" min="0.4" max="0.99" placeholder="0.87" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Inner Dia D<sub>i</sub> (mm)</label>
                        <input id="m-di" type="number" step="0.5" min="30" placeholder="190" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Core Length L (mm)</label>
                        <input id="m-len" type="number" step="0.5" min="20" placeholder="220" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Turns / Phase</label>
                        <input id="m-turns" type="number" step="1" min="1" placeholder="96" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Cond. Area (mm²)</label>
                        <input id="m-area" type="number" step="0.01" min="0.1" placeholder="5.2" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">No-Load Curr. (A)</label>
                        <input id="m-i0" type="number" step="0.1" min="0.05" placeholder="8.5" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Start Torque (%)</label>
                        <input id="m-tst" type="number" step="1" min="50" placeholder="210" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Start Current (%)</label>
                        <input id="m-ist" type="number" step="1" min="200" placeholder="680" class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-600/80 text-sm text-white">
                    </div>
                </div>
                <div class="flex justify-end">
                    <button id="add-manual-motor-btn" type="button" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-plus"></i> Add Motor to Database
                    </button>
                </div>
            </div>

            <!-- Collapsible Active Motor Database Table -->
            <div id="db-table-container" class="hidden overflow-x-auto rounded-xl border border-slate-700/80 bg-slate-900/50 fade-in">
                <table class="w-full text-left text-xs sm:text-sm border-collapse">
                    <thead>
                        <tr class="bg-slate-800/90 text-slate-300 border-b border-slate-700">
                            <th class="py-2.5 px-3 font-semibold">Frame</th>
                            <th class="py-2.5 px-3 font-semibold">Power (kW)</th>
                            <th class="py-2.5 px-3 font-semibold">V / Hz / P</th>
                            <th class="py-2.5 px-3 font-semibold">Conn</th>
                            <th class="py-2.5 px-3 font-semibold">&eta; / PF</th>
                            <th class="py-2.5 px-3 font-semibold">D<sub>i</sub> &times; L (mm)</th>
                            <th class="py-2.5 px-3 font-semibold">Turns</th>
                            <th class="py-2.5 px-3 font-semibold">A<sub>c</sub> (mm²)</th>
                            <th class="py-2.5 px-3 font-semibold">I<sub>0</sub> (A)</th>
                            <th class="py-2.5 px-3 font-semibold">T<sub>st</sub> / I<sub>st</sub> (%)</th>
                            <th class="py-2.5 px-3 font-semibold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="db-table-body" class="divide-y divide-slate-800 text-slate-200"></tbody>
                </table>
            </div>
        </section>

        <!-- Section 2: Motor Design Parameters (Batch Supported) -->
        <section class="glass-card rounded-2xl p-5 sm:p-6 space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-700/80">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div>
                        <h2 class="text-lg sm:text-xl font-semibold text-white">Motor Design Parameters</h2>
                        <p class="text-xs text-slate-400">Configure single or multi-motor batch specifications (1 to 5 motors)</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <label for="num-motors" class="text-xs sm:text-sm font-medium text-slate-300">Motors in Batch:</label>
                    <select id="num-motors" class="px-3 py-2 rounded-lg border border-slate-600/80 bg-slate-800 text-white text-sm font-semibold">
                        <option value="1" selected>1 Motor</option>
                        <option value="2">2 Motors</option>
                        <option value="3">3 Motors</option>
                        <option value="4">4 Motors</option>
                        <option value="5">5 Motors</option>
                    </select>
                </div>
            </div>

            <!-- Batch Input Tabs -->
            <div id="batch-tabs-bar" class="hidden flex flex-wrap items-center justify-between gap-2 border-b border-slate-700/70 pb-3">
                <div id="batch-tabs-list" class="flex flex-wrap gap-2"></div>
                <button id="copy-motor1-btn" type="button" class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600/80 text-sky-300 transition flex items-center gap-1.5 cursor-pointer">
                    <i class="fas fa-copy"></i> Copy Motor #1 to Active Tab
                </button>
            </div>

            <!-- Validation Error Banner -->
            <div id="validation-banner" class="hidden bg-rose-500/15 border border-rose-500/40 text-rose-200 rounded-xl p-4 text-sm space-y-1 fade-in">
                <div class="font-semibold flex items-center gap-2 text-rose-300">
                    <i class="fas fa-exclamation-triangle"></i> Please correct the following validation errors:
                </div>
                <ul id="validation-error-list" class="list-disc list-inside text-xs sm:text-sm space-y-0.5 pl-1"></ul>
            </div>

            <!-- Dynamic Batch Form Panels Container -->
            <div id="batch-forms-container"></div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-slate-700/80">
                <button id="reset-btn" type="button" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-700/80 hover:bg-slate-600 text-slate-100 font-medium text-sm transition flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-redo"></i> Full Reset
                </button>
                <button id="calculate-btn" type="button" class="w-full sm:w-auto px-7 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 disabled:opacity-50 disabled:cursor-not-allowed text-slate-950 font-bold text-sm sm:text-base transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-bolt"></i> <span>Calculate Design</span>
                </button>
            </div>
        </section>

        <!-- Loading Indicator -->
        <div id="loading" class="hidden glass-card rounded-2xl p-10 text-center space-y-4">
            <div class="spinner mx-auto"></div>
            <p class="text-slate-300 font-medium">Running IEC 60034-1 derating &amp; winding redesign calculations...</p>
        </div>

        <!-- Section 3: Dynamic Results Container -->
        <section id="results-container" class="hidden glass-card rounded-2xl p-5 sm:p-6 space-y-6 fade-in">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-700/80">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div>
                        <h2 class="text-lg sm:text-xl font-semibold text-white">Design Calculation Results</h2>
                        <p class="text-xs text-slate-400">Computed from active reference database with nonlinear magnetic saturation &amp; thermal checks</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button id="export-btn" type="button" class="px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs sm:text-sm transition flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-file-csv"></i> Export CSV
                    </button>
                    <button id="new-design-btn" type="button" class="px-4 py-2.5 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-100 font-medium text-xs sm:text-sm transition flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-arrow-up"></i> Modify Inputs
                    </button>
                </div>
            </div>

            <!-- Dynamic Summary Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" id="results-summary-grid"></div>

            <!-- Dynamic Result Tabs -->
            <div id="result-tabs-bar" class="flex flex-wrap gap-2 border-b border-slate-700/80 pb-3"></div>

            <!-- Dynamic Result Tab Contents -->
            <div id="result-tabs-content"></div>
        </section>

        <!-- Footer -->
        <footer class="text-center text-xs text-slate-500 pb-4">
            3-Phase Induction Motor Design Calculator &bull; IEC 60034-1 Thermal &amp; Altitude Derating &bull; First-Principles Winding Scaling
        </footer>
    </div>

    <!-- Automated Test Runner Modal -->
    <div id="test-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="glass-card rounded-2xl max-w-3xl w-full max-h-[85vh] flex flex-col overflow-hidden border border-slate-600/80 shadow-2xl fade-in">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700/80 bg-slate-900/60">
                <div class="flex items-center gap-3">
                    <i class="fas fa-vial text-indigo-400 text-xl"></i>
                    <div>
                        <h3 class="text-lg font-bold text-white">Automated Engineering Verification Suite</h3>
                        <p class="text-xs text-slate-400">Live unit tests verifying math, validation, warnings, and CSV export</p>
                    </div>
                </div>
                <button id="close-test-modal" type="button" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="test-modal-summary" class="px-6 py-3 bg-slate-800/60 border-b border-slate-700/70 flex items-center justify-between text-sm"></div>
            <div id="test-results-list" class="p-6 overflow-y-auto space-y-3"></div>
            <div class="px-6 py-3.5 border-t border-slate-700/80 bg-slate-900/60 flex justify-end gap-2">
