        /* =========================================================================
           8. AUTOMATED UNIT TEST SUITE (5 TESTS)
           ========================================================================= */
        function runAutomatedTestSuite() {
            const results = [];

            function record(name, passed, details) {
                results.push({ name, passed, details });
            }

            // TEST 1: Star-to-Delta Phase Turns Scaling (sqrt(3) verification)
            try {
                const starBase = DEFAULT_MOTOR_DB.find(m => m.frameSize === '80'); // 1.5 kW, 415V, 50Hz, 4P, Star, 360 turns
                const deltaInput = {
                    powerKw: 1.5, voltageV: 415, frequencyHz: 50, poles: 4,
                    ambientTempC: 40, insulationClass: 'F', connection: 'Delta',
                    altitudeM: 0, fixedDimensions: true, frameSize: '80'
                };
                const res = designSingleMotor(deltaInput, DEFAULT_MOTOR_DB);
                const ratio = res.exactTurns / starBase.turnsPerPhase;
                const expected = Math.sqrt(3);
                const diff = Math.abs(ratio - expected);
                const passed = diff < 1e-4;
                record(
                    '1. Star-to-Delta Phase Turns Scaling (√3 Verification)',
                    passed,
                    `Base Star Turns = ${starBase.turnsPerPhase}, Delta Exact Turns = ${res.exactTurns.toFixed(3)}, Ratio = ${ratio.toFixed(5)} (Expected √3 ≈ ${expected.toFixed(5)}, Δ = ${diff.toExponential(2)})`
                );
            } catch (e) {
                record('1. Star-to-Delta Phase Turns Scaling (√3 Verification)', false, `Exception: ${e.message}`);
            }

            // TEST 2: IEC 60034-1 Altitude & Ambient Temperature Derating Math
            try {
                const d1 = calculateDerating(50, 2000, 'B'); // 50°C Class B -> 0.90; 2000m -> 0.90; total -> 0.81
                const d2 = calculateDerating(40, 1000, 'F'); // 40°C & 1000m -> 1.00, 1.00, 1.00
                const passed = Math.abs(d1.kAlt - 0.90) < 1e-4
                    && Math.abs(d1.kTemp - 0.90) < 1e-4
                    && Math.abs(d1.kTotal - 0.81) < 1e-4
                    && d2.kTotal === 1.0;
                record(
                    '2. IEC 60034-1 Altitude & Ambient Temperature Derating',
                    passed,
                    `50°C / 2000m / Class B => k_temp=${d1.kTemp}, k_alt=${d1.kAlt}, k_total=${d1.kTotal} (Expected 0.90, 0.90, 0.81); 40°C / 1000m => k_total=${d2.kTotal}`
                );
            } catch (e) {
                record('2. IEC 60034-1 Altitude & Ambient Temperature Derating', false, `Exception: ${e.message}`);
            }

            // TEST 3: Invalid Input Rejection
            try {
                const vNegPower = validateMotorInput({ ...createDefaultMotorInput(), powerKw: -2.5 }, DEFAULT_MOTOR_DB);
                const vZeroVolt = validateMotorInput({ ...createDefaultMotorInput(), voltageV: 0 }, DEFAULT_MOTOR_DB);
                const vHighAlt = validateMotorInput({ ...createDefaultMotorInput(), altitudeM: 6500 }, DEFAULT_MOTOR_DB);
                const vMissingFrame = validateMotorInput({ ...createDefaultMotorInput(), fixedDimensions: true, frameSize: '' }, DEFAULT_MOTOR_DB);
                const passed = !vNegPower.valid && !vZeroVolt.valid && !vHighAlt.valid && !vMissingFrame.valid;
                record(
                    '3. Strict Invalid Input Rejection',
                    passed,
                    `Rejected negative power (${!vNegPower.valid}), zero voltage (${!vZeroVolt.valid}), 6500m altitude (${!vHighAlt.valid}), missing fixed frame (${!vMissingFrame.valid}).`
                );
            } catch (e) {
                record('3. Strict Invalid Input Rejection', false, `Exception: ${e.message}`);
            }

            // TEST 4: Fixed-Dimension Thermal Overload Warning Trigger
            try {
                const overloadInput = {
                    powerKw: 5.5, voltageV: 415, frequencyHz: 50, poles: 4,
                    ambientTempC: 45, insulationClass: 'B', connection: 'Delta',
                    altitudeM: 1200, fixedDimensions: true, frameSize: '71'
                };
                const res = designSingleMotor(overloadInput, DEFAULT_MOTOR_DB);
                const hasThermalWarning = res.warnings.some(w => w.type === 'thermal');
                const passed = hasThermalWarning && res.coActual > 1.15 * res.coStd;
                record(
                    '4. Fixed-Dimension Thermal Overload Warning Trigger',
                    passed,
                    `5.5 kW forced into Frame 71 => Co_actual=${res.coActual.toFixed(1)} vs 1.15×Co_std=${(1.15 * res.coStd).toFixed(1)}, Thermal Warning Fired = ${hasThermalWarning}`
                );
            } catch (e) {
                record('4. Fixed-Dimension Thermal Overload Warning Trigger', false, `Exception: ${e.message}`);
            }

            // TEST 5: CSV Export String Generation & Escaping
            try {
                const sampleRes = designSingleMotor(createDefaultMotorInput(), DEFAULT_MOTOR_DB);
                // Inject a warning with comma and quotes to verify RFC 4180 escaping
                sampleRes.warnings.push({ type: 'test', severity: 'info', message: 'Check "slot", fill' });
                const csv = buildResultsCsv({ motors: [sampleRes], calcTimeMs: 1.2 });
                const lines = csv.split('\n');
                const escapedProperly = csv.includes('"Check ""slot"", fill"');
                const passed = lines.length === 4 && lines[0].startsWith('Motor #,Target Power (kW)') && escapedProperly;
                record(
                    '5. CSV Export Generation & RFC 4180 Escaping',
                    passed,
                    `Generated ${lines.length} CSV lines (1 header + 3 option rows), Header verified = ${lines[0].startsWith('Motor #')}, Quotes/Comma Escaping = ${escapedProperly}`
                );
            } catch (e) {
                record('5. CSV Export Generation & RFC 4180 Escaping', false, `Exception: ${e.message}`);
            }

            return results;
        }

        function renderTestModal() {
            const modal = document.getElementById('test-modal');
            const summaryEl = document.getElementById('test-modal-summary');
            const listEl = document.getElementById('test-results-list');

            const results = runAutomatedTestSuite();
            const passCount = results.filter(r => r.passed).length;
            const allPassed = passCount === results.length;

            summaryEl.innerHTML = `
                <span class="font-semibold text-slate-200">Executed ${results.length} Automated Tests</span>
                <span class="px-3 py-1 rounded-full text-xs font-bold ${allPassed ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-rose-500/20 text-rose-300 border border-rose-500/40'}">
                    ${passCount} / ${results.length} PASSED
                </span>
            `;

            listEl.innerHTML = results.map(r => `
                <div class="rounded-xl p-4 border ${r.passed ? 'bg-emerald-500/10 border-emerald-500/30' : 'bg-rose-500/10 border-rose-500/30'}">
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <span class="font-semibold text-sm text-white">${escapeHtml(r.name)}</span>
                        <span class="px-2.5 py-0.5 rounded-md text-xs font-bold ${r.passed ? 'bg-emerald-500 text-slate-950' : 'bg-rose-500 text-white'}">
                            ${r.passed ? 'PASS' : 'FAIL'}
                        </span>
                    </div>
                    <p class="text-xs text-slate-300 font-mono leading-relaxed">${escapeHtml(r.details)}</p>
                </div>
            `).join('');

            modal.classList.remove('hidden');
        }

        /* =========================================================================
           9. EVENT LISTENERS & INITIALIZATION
           ========================================================================= */
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize state & UI
            state.batchInputs = [createDefaultMotorInput()];
            renderDatabaseTable();
            updateDataStatus();
            renderBatchForms();

            // Toggle Active Database Table
            document.getElementById('toggle-db-btn').addEventListener('click', () => {
                const container = document.getElementById('db-table-container');
                const chevron = document.getElementById('toggle-db-chevron');
                container.classList.toggle('hidden');
                chevron.classList.toggle('rotate-180');
            });

            // Restore Default Database
            document.getElementById('restore-db-btn').addEventListener('click', () => {
                state.motorDb = JSON.parse(JSON.stringify(DEFAULT_MOTOR_DB));
                renderDatabaseTable();
                updateDataStatus();
                renderBatchForms();
                showToast('Restored built-in 8 IEC standard motors.', 'success');
            });

            // Data Source Mode Switch
            const dataSourceSelect = document.getElementById('data-source');
            const uploadSection = document.getElementById('upload-section');
            const manualSection = document.getElementById('manual-section');
            const statusWrapper = document.getElementById('status-wrapper');

            dataSourceSelect.addEventListener('change', () => {
                const mode = dataSourceSelect.value;
                uploadSection.classList.toggle('hidden', mode !== 'upload');
                manualSection.classList.toggle('hidden', mode !== 'manual');
                statusWrapper.classList.toggle('hidden', mode === 'upload');
            });

            // Download Sample CSV Template
            document.getElementById('download-template-btn').addEventListener('click', () => {
                const header = REQUIRED_DB_COLUMNS.join(',');
                const rows = DEFAULT_MOTOR_DB.slice(0, 3).map(m =>
                    REQUIRED_DB_COLUMNS.map(col => escapeCsvCell(m[col])).join(',')
                );
                const csvContent = [header, ...rows].join('\n');
                triggerDownload(csvContent, 'iec_motor_database_template.csv', 'text/csv;charset=utf-8;');
                showToast('Downloaded sample CSV template.', 'success');
            });

            // SheetJS Excel / CSV Upload
            document.getElementById('upload-btn').addEventListener('click', () => {
                const fileInput = document.getElementById('excel-file');
                const errorBox = document.getElementById('upload-error');
                errorBox.classList.add('hidden');

                if (!fileInput.files || fileInput.files.length === 0) {
                    errorBox.textContent = 'Please select an .xlsx, .xls, or .csv file first.';
                    errorBox.classList.remove('hidden');
                    return;
                }

                if (typeof XLSX === 'undefined') {
                    errorBox.textContent = 'SheetJS library failed to load. Check your internet connection.';
                    errorBox.classList.remove('hidden');
                    return;
                }

                const file = fileInput.files[0];
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                        const jsonRows = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

                        if (!jsonRows || jsonRows.length === 0) {
                            throw new Error('The uploaded file contains no data rows.');
                        }

                        const fileCols = Object.keys(jsonRows[0]);
                        const missingCols = REQUIRED_DB_COLUMNS.filter(c => !fileCols.includes(c));
                        if (missingCols.length > 0) {
                            throw new Error(`Missing required column(s): ${missingCols.join(', ')}`);
                        }

                        const importedMotors = [];
                        jsonRows.forEach((row, i) => {
                            const m = {
                                id: `imp-${Date.now()}-${i}`,
                                frameSize: String(row.frameSize).trim(),
                                powerKw: Number(row.powerKw),
                                voltageV: Number(row.voltageV),
                                frequencyHz: Number(row.frequencyHz),
                                poles: Number(row.poles),
                                connection: String(row.connection).trim(),
                                efficiencyPct: Number(row.efficiencyPct),
                                powerFactor: Number(row.powerFactor),
                                innerDiameterMm: Number(row.innerDiameterMm),
                                coreLengthMm: Number(row.coreLengthMm),
                                turnsPerPhase: Number(row.turnsPerPhase),
                                conductorAreaMm2: Number(row.conductorAreaMm2),
                                noLoadCurrentA: Number(row.noLoadCurrentA),
                                startingTorquePct: Number(row.startingTorquePct),
                                startingCurrentPct: Number(row.startingCurrentPct),
                                isDefault: false
                            };
                            if (!m.frameSize || isNaN(m.powerKw) || m.powerKw <= 0 || isNaN(m.turnsPerPhase) || m.turnsPerPhase <= 0) {
                                throw new Error(`Row ${i + 2} has invalid numeric or frameSize values.`);
                            }
                            if (!['Star', 'Delta'].includes(m.connection)) {
                                throw new Error(`Row ${i + 2}: connection must be "Star" or "Delta".`);
                            }
                            importedMotors.push(m);
                        });

                        state.motorDb = [...state.motorDb, ...importedMotors];
                        renderDatabaseTable();
                        updateDataStatus();
                        renderBatchForms();
                        fileInput.value = '';
                        showToast(`Imported ${importedMotors.length} motor(s) into active database.`, 'success');
                    } catch (err) {
                        errorBox.textContent = `Import failed: ${err.message}`;
                        errorBox.classList.remove('hidden');
                    }
                };
                reader.readAsArrayBuffer(file);
            });

            // Add Custom Motor Manually
            document.getElementById('add-manual-motor-btn').addEventListener('click', () => {
                const errEl = document.getElementById('manual-error');
                errEl.classList.add('hidden');

                const m = {
                    id: `custom-${Date.now()}`,
                    frameSize: document.getElementById('m-frame').value.trim(),
                    powerKw: Number(document.getElementById('m-power').value),
                    voltageV: Number(document.getElementById('m-voltage').value),
                    frequencyHz: Number(document.getElementById('m-freq').value),
                    poles: Number(document.getElementById('m-poles').value),
                    connection: document.getElementById('m-conn').value,
                    efficiencyPct: Number(document.getElementById('m-eff').value),
                    powerFactor: Number(document.getElementById('m-pf').value),
                    innerDiameterMm: Number(document.getElementById('m-di').value),
                    coreLengthMm: Number(document.getElementById('m-len').value),
                    turnsPerPhase: Number(document.getElementById('m-turns').value),
                    conductorAreaMm2: Number(document.getElementById('m-area').value),
                    noLoadCurrentA: Number(document.getElementById('m-i0').value),
                    startingTorquePct: Number(document.getElementById('m-tst').value),
                    startingCurrentPct: Number(document.getElementById('m-ist').value),
                    isDefault: false
                };

                const errs = [];
                if (!m.frameSize) errs.push('Frame Size is required.');
                if (isNaN(m.powerKw) || m.powerKw <= 0) errs.push('Power must be > 0.');
                if (isNaN(m.voltageV) || m.voltageV < 100) errs.push('Voltage must be ≥ 100 V.');
                if (isNaN(m.frequencyHz) || m.frequencyHz < 10) errs.push('Frequency must be ≥ 10 Hz.');
                if (isNaN(m.efficiencyPct) || m.efficiencyPct < 50 || m.efficiencyPct > 99) errs.push('Efficiency must be 50–99%.');
                if (isNaN(m.powerFactor) || m.powerFactor < 0.4 || m.powerFactor > 0.99) errs.push('Power Factor must be 0.40–0.99.');
                if (isNaN(m.innerDiameterMm) || m.innerDiameterMm <= 0) errs.push('Inner Diameter must be > 0.');
                if (isNaN(m.coreLengthMm) || m.coreLengthMm <= 0) errs.push('Core Length must be > 0.');
                if (isNaN(m.turnsPerPhase) || m.turnsPerPhase < 1) errs.push('Turns/Phase must be ≥ 1.');
                if (isNaN(m.conductorAreaMm2) || m.conductorAreaMm2 <= 0) errs.push('Conductor Area must be > 0.');
                if (isNaN(m.noLoadCurrentA) || m.noLoadCurrentA <= 0) errs.push('No-Load Current must be > 0.');
                if (isNaN(m.startingTorquePct) || m.startingTorquePct <= 0) errs.push('Starting Torque must be > 0.');
                if (isNaN(m.startingCurrentPct) || m.startingCurrentPct <= 0) errs.push('Starting Current must be > 0.');

                if (errs.length > 0) {
                    errEl.textContent = errs.join(' ');
                    errEl.classList.remove('hidden');
                    return;
                }

                state.motorDb.push(m);
                renderDatabaseTable();
                updateDataStatus();
                renderBatchForms();
                showToast(`Added custom motor (Frame ${m.frameSize}, ${m.powerKw} kW) to database.`, 'success');
            });

            // Number of Motors in Batch
            document.getElementById('num-motors').addEventListener('change', (e) => {
                syncActiveBatchFormToState();
                state.numMotors = clamp(Number(e.target.value), 1, 5);
                renderBatchForms();
            });

            // Copy Motor #1 to Active Tab
            document.getElementById('copy-motor1-btn').addEventListener('click', () => {
                if (state.activeBatchTab === 0) {
                    showToast('Already on Motor #1.', 'info');
                    return;
                }
                state.batchInputs[state.activeBatchTab] = { ...state.batchInputs[0] };
                renderBatchForms();
                showToast(`Copied Motor #1 parameters to Motor #${state.activeBatchTab + 1}.`, 'success');
            });

            // Calculate Design Button
            const calcBtn = document.getElementById('calculate-btn');
            calcBtn.addEventListener('click', () => {
                syncActiveBatchFormToState();

                const valBanner = document.getElementById('validation-banner');
                const valList = document.getElementById('validation-error-list');
                valBanner.classList.add('hidden');
                valList.innerHTML = '';

                const allErrors = [];
                state.batchInputs.forEach((inp, idx) => {
                    const check = validateMotorInput(inp, state.motorDb, `Motor #${idx + 1}`);
                    if (!check.valid) allErrors.push(...check.errors);
                });

                if (allErrors.length > 0) {
                    valList.innerHTML = allErrors.map(err => `<li>${escapeHtml(err)}</li>`).join('');
                    valBanner.classList.remove('hidden');
                    valBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }

                // Disable button & show loading
                calcBtn.disabled = true;
                const loadingEl = document.getElementById('loading');
                const resultsEl = document.getElementById('results-container');
                resultsEl.classList.add('hidden');
                loadingEl.classList.remove('hidden');

                setTimeout(() => {
                    try {
                        const t0 = performance.now();
                        const motors = state.batchInputs.map(inp => designSingleMotor(inp, state.motorDb));
                        const calcTimeMs = Math.max(0.05, performance.now() - t0);

                        state.lastResults = { motors, calcTimeMs };
                        state.activeResultTab = 0;

                        loadingEl.classList.add('hidden');
                        renderResults(state.lastResults);
                        resultsEl.scrollIntoView({ behavior: 'smooth' });
                        showToast(`Successfully calculated ${motors.length} motor design(s).`, 'success');
                    } catch (err) {
                        loadingEl.classList.add('hidden');
                        showToast(`Calculation error: ${err.message}`, 'error');
                    } finally {
                        calcBtn.disabled = false;
                    }
                }, 260);
            });

            // Full Reset Button
            document.getElementById('reset-btn').addEventListener('click', () => {
                state.numMotors = 1;
                state.activeBatchTab = 0;
                state.batchInputs = [createDefaultMotorInput()];
                state.lastResults = null;

                document.getElementById('num-motors').value = '1';
                document.getElementById('validation-banner').classList.add('hidden');
                document.getElementById('results-container').classList.add('hidden');
                renderBatchForms();
                showToast('All design inputs and results have been reset.', 'info');
            });

            // Modify Inputs / Scroll Top
            document.getElementById('new-design-btn').addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // Real CSV Export Button
            document.getElementById('export-btn').addEventListener('click', () => {
                if (!state.lastResults) {
                    showToast('No calculation results available to export.', 'warning');
                    return;
                }
                const csvString = buildResultsCsv(state.lastResults);
                triggerDownload(csvString, 'motor_design_results.csv', 'text/csv;charset=utf-8;');
                showToast('Exported motor_design_results.csv', 'success');
            });

            // Automated Test Modal Controls
            document.getElementById('run-tests-btn').addEventListener('click', renderTestModal);
            document.getElementById('rerun-tests-btn').addEventListener('click', renderTestModal);
            const closeModal = () => document.getElementById('test-modal').classList.add('hidden');
            document.getElementById('close-test-modal').addEventListener('click', closeModal);
            document.getElementById('close-test-modal-footer').addEventListener('click', closeModal);
            document.getElementById('test-modal').addEventListener('click', (e) => {
                if (e.target.id === 'test-modal') closeModal();
            });
        });

        function triggerDownload(content, filename, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
</body>
</html>
